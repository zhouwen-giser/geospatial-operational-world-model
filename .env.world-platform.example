# Operator deployment configuration. Generate distinct credentials; never commit the real .env.
COMPOSE_PROJECT_NAME=gowm-world-platform-local
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_32_CHAR_PASSWORD
STAS_DB_PASSWORD=REPLACE_WITH_UNIQUE_STAS_32_CHAR_PASSWORD
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8090
GATEWAY_DATA_SCOPE_CLAIM=your-data-scope
GATEWAY_DATASET_SCOPE_CLAIM=your-dataset-scope
GATEWAY_RUNTIME_PRINCIPAL_REF=world-platform-consumer
GATEWAY_AUTH_SHARED_TOKEN=REPLACE_WITH_UNIQUE_32_CHAR_TOKEN
# STATIC_SERVICE preserves v0.6.2 behavior. SIGNED_DELEGATION_V1 additionally
# requires the issuer, audience and PEM public key variables below.
GATEWAY_AUTH_MODE=STATIC_SERVICE
GATEWAY_DELEGATION_MAXIMUM_TTL_SECONDS=300
# GATEWAY_DELEGATION_ISSUER=https://identity.example.internal
# GATEWAY_DELEGATION_AUDIENCE=gowm-world-gateway
# GATEWAY_DELEGATION_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
GROUNDING_CURSOR_HMAC_SECRET=REPLACE_WITH_UNIQUE_32_CHAR_SECRET
SPATIAL_CURSOR_HMAC_SECRET=REPLACE_WITH_UNIQUE_32_CHAR_SECRET
SPATIAL_POSTGIS_VERSION=3.6.4
H3_TOOLKIT_BINDINGS_HOST_PATH=/absolute/path/to/h3-bindings.mjs
H3_TOOLKIT_BINDINGS_MODULE_SHA256=sha256:fe1d48cf795e45d7004024a64efb1a792fa42de9a6f2f036ef92a1057ffc2a61
GATEWAY_DB_PASSWORD=REPLACE_WITH_UNIQUE_GATEWAY_32_CHAR_PASSWORD
GATEWAY_REGISTRY_DB_PASSWORD=REPLACE_WITH_UNIQUE_GATEWAY_REGISTRY_32_CHAR_PASSWORD
SPATIAL_DB_PASSWORD=REPLACE_WITH_UNIQUE_SPATIAL_32_CHAR_PASSWORD
SITUATION_DB_PASSWORD=REPLACE_WITH_UNIQUE_SITUATION_32_CHAR_PASSWORD
REFERENCE_DB_PASSWORD=REPLACE_WITH_UNIQUE_REFERENCE_32_CHAR_PASSWORD
CATALOG_DB_PASSWORD=REPLACE_WITH_UNIQUE_CATALOG_32_CHAR_PASSWORD
EVIDENCE_DB_PASSWORD=REPLACE_WITH_UNIQUE_EVIDENCE_32_CHAR_PASSWORD
OPERATIONAL_DB_PASSWORD=REPLACE_WITH_UNIQUE_OPERATIONAL_32_CHAR_PASSWORD
VALIDATION_DB_PASSWORD=REPLACE_WITH_UNIQUE_VALIDATION_32_CHAR_PASSWORD
NETWORK_DB_PASSWORD=REPLACE_WITH_UNIQUE_NETWORK_32_CHAR_PASSWORD
ROUTE_DB_PASSWORD=REPLACE_WITH_UNIQUE_ROUTE_32_CHAR_PASSWORD
COVERAGE_DB_PASSWORD=REPLACE_WITH_UNIQUE_COVERAGE_32_CHAR_PASSWORD
CRS_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_CRS_PROVIDER_TRANSPORT_TOKEN
DATASET_CATALOG_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_DATASET_CATALOG_PROVIDER_TRANSPORT_TOKEN
GEOMETRY_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_GEOMETRY_PROVIDER_TRANSPORT_TOKEN
H3_ANALYSIS_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_H3_ANALYSIS_PROVIDER_TRANSPORT_TOKEN
H3_INTERACTIVE_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_H3_INTERACTIVE_PROVIDER_TRANSPORT_TOKEN
NETWORK_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_NETWORK_PROVIDER_TRANSPORT_TOKEN
OPERATIONAL_REALITY_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_OPERATIONAL_REALITY_PROVIDER_TRANSPORT_TOKEN
PLATFORM_VALIDATION_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_PLATFORM_VALIDATION_PROVIDER_TRANSPORT_TOKEN
REFERENCE_CATALOG_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_REFERENCE_CATALOG_PROVIDER_TRANSPORT_TOKEN
COVERAGE_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_COVERAGE_PROVIDER_TRANSPORT_TOKEN
ROUTE_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_ROUTE_PROVIDER_TRANSPORT_TOKEN
SITUATION_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_SITUATION_PROVIDER_TRANSPORT_TOKEN
SPATIAL_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_SPATIAL_PROVIDER_TRANSPORT_TOKEN
STAS_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_STAS_PROVIDER_TRANSPORT_TOKEN
WORLD_EVIDENCE_PROVIDER_TRANSPORT_TOKEN=REPLACE_WITH_UNIQUE_WORLD_EVIDENCE_PROVIDER_TRANSPORT_TOKEN
