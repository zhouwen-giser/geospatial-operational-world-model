{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:capability-versions-response",
  "title": "CapabilityVersionsResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "operationId", "versions"],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^registry-[0-9]+$"
    },
    "operationId": {
      "$ref": "common-definitions.schema.json#/$defs/operationId"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "capability-descriptor.schema.json" }
    }
  }
}
