{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:gateway-execute-request",
  "title": "GatewayExecuteRequest",
  "description": "Untrusted public request. Authentication and data-scope claims are derived from the transport, never accepted here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestVersion",
    "requestId",
    "idempotencyKey",
    "operationVersion",
    "inputSchemaHash",
    "outputSchemaHash",
    "input",
    "executionPolicy"
  ],
  "properties": {
    "requestVersion": { "const": "1.0" },
    "requestId": { "$ref": "common-definitions.schema.json#/$defs/identifier" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "operationVersion": {
      "$ref": "common-definitions.schema.json#/$defs/operationVersion"
    },
    "inputSchemaHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256Digest"
    },
    "outputSchemaHash": {
      "$ref": "common-definitions.schema.json#/$defs/sha256Digest"
    },
    "input": {},
    "executionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadlineAt", "maximumResultBytes", "maximumCostClass"],
      "properties": {
        "deadlineAt": { "type": "string", "format": "date-time" },
        "maximumResultBytes": { "type": "integer", "minimum": 1 },
        "maximumRows": { "type": "integer", "minimum": 1 },
        "maximumCandidates": { "type": "integer", "minimum": 1 },
        "maximumCostClass": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "preferredExecution": { "enum": ["SYNC", "ASYNC", "AUTO"] }
      }
    },
    "snapshotRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consistency"],
      "properties": {
        "consistency": {
          "enum": ["PINNED", "CONSISTENT_AT_START", "BEST_EFFORT"]
        },
        "resourcePins": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "common-definitions.schema.json#/$defs/referenceKey"
          }
        }
      }
    }
  }
}
