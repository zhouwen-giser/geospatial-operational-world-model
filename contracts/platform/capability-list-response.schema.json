{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:capability-list-response",
  "title": "CapabilityListResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "capabilities"],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^registry-[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "capability-descriptor.schema.json" }
    }
  }
}
