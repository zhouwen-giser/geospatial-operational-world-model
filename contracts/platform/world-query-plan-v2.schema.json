{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:world-query-plan-v2",
  "title": "WorldQueryPlanV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["queryPlanVersion", "queryId", "nodes", "outputs", "budgets"],
  "properties": {
    "queryPlanVersion": { "const": "2.0" },
    "queryId": { "$ref": "common-definitions.schema.json#/$defs/identifier" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/node" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "binding"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" },
          "binding": { "$ref": "#/$defs/nodeOutputBinding" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumNodes",
        "maximumDepth",
        "maximumRows",
        "maximumCandidates",
        "maximumOutputBytes",
        "maximumExecutionMs"
      ],
      "properties": {
        "maximumNodes": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maximumRows": { "type": "integer", "minimum": 1 },
        "maximumCandidates": { "type": "integer", "minimum": 1 },
        "maximumOutputBytes": { "type": "integer", "minimum": 1 },
        "maximumExecutionMs": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "targetPath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512,
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "schemaPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaUri", "schemaHash", "valueKind", "unitSemantics"],
      "properties": {
        "schemaUri": { "$ref": "common-definitions.schema.json#/$defs/schemaUri" },
        "schemaHash": { "$ref": "common-definitions.schema.json#/$defs/sha256Digest" },
        "valueKind": {
          "enum": [
            "ANY",
            "SCALAR",
            "POSITION",
            "POSITIONS",
            "GEOMETRY",
            "FEATURE",
            "FEATURE_COLLECTION",
            "H3_CELL",
            "H3_CELL_SET",
            "REFERENCE_KEY",
            "DATASET_VERSION",
            "ROW_SET",
            "ARTIFACT_REFERENCE"
          ]
        },
        "unitSemantics": {
          "enum": [
            "UNSPECIFIED",
            "DIMENSIONLESS",
            "ANGULAR_DEGREES",
            "LINEAR_METERS",
            "DISCRETE"
          ]
        }
      }
    },
    "literalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "value"],
      "properties": {
        "kind": { "const": "LITERAL" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "value": {},
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "requestPathBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "path"],
      "properties": {
        "kind": { "const": "REQUEST_PATH" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "path": { "type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$" },
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "nodeOutputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "nodeId", "outputPort"],
      "properties": {
        "kind": { "const": "NODE_OUTPUT" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "nodeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "outputPort": { "type": "string", "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" },
        "path": { "type": "string", "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$" },
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "referenceKeyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "referenceKey"],
      "properties": {
        "kind": { "const": "REFERENCE_KEY" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "referenceKey": { "$ref": "common-definitions.schema.json#/$defs/referenceKey" },
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "datasetVersionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "datasetId", "version"],
      "properties": {
        "kind": { "const": "DATASET_VERSION" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "datasetId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "port", "artifactId", "digest"],
      "properties": {
        "kind": { "const": "ARTIFACT_REFERENCE" },
        "port": { "$ref": "#/$defs/schemaPort" },
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "$ref": "common-definitions.schema.json#/$defs/sha256Digest" },
        "targetPath": { "$ref": "#/$defs/targetPath" }
      }
    },
    "inputBinding": {
      "oneOf": [
        { "$ref": "#/$defs/literalBinding" },
        { "$ref": "#/$defs/requestPathBinding" },
        { "$ref": "#/$defs/nodeOutputBinding" },
        { "$ref": "#/$defs/referenceKeyBinding" },
        { "$ref": "#/$defs/datasetVersionBinding" },
        { "$ref": "#/$defs/artifactBinding" }
      ]
    },
    "precondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodeId", "statuses"],
          "properties": {
            "kind": { "const": "NODE_STATUS" },
            "nodeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
            "statuses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["COMPLETED", "PARTIAL", "NO_DATA"] }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding"],
          "properties": {
            "kind": { "const": "VALUE_PRESENT" },
            "binding": { "$ref": "#/$defs/inputBinding" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "binding", "value"],
          "properties": {
            "kind": { "const": "VALUE_EQUALS" },
            "binding": { "$ref": "#/$defs/inputBinding" },
            "value": {}
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "operation", "inputs", "failurePolicy", "budget"],
      "properties": {
        "nodeId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "operation": { "$ref": "common-definitions.schema.json#/$defs/operationRef" },
        "inputs": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/inputBinding" }
        },
        "failurePolicy": {
          "enum": ["FAIL_FAST", "ALLOW_PARTIAL", "SKIP_IF_PRECONDITION_FALSE"]
        },
        "preconditions": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/precondition" }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumRows",
            "maximumCandidates",
            "maximumOutputBytes",
            "maximumExecutionMs"
          ],
          "properties": {
            "maximumRows": { "type": "integer", "minimum": 1 },
            "maximumCandidates": { "type": "integer", "minimum": 1 },
            "maximumOutputBytes": { "type": "integer", "minimum": 1 },
            "maximumExecutionMs": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
