{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:h3.neighborhood.disk:output:1.0",
  "title": "H3NeighborhoodDiskOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin", "radius", "cells"],
  "properties": {
    "origin": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" },
    "radius": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "cells": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" }
    }
  }
}
