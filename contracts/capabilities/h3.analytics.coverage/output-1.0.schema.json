{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:h3.analytics.coverage:output:1.0",
  "title": "H3AnalyticsCoverageOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolution", "requiredCells", "visitedCells", "missingCells", "duplicateCells", "requiredCount", "visitedRequiredCount", "missingCount", "duplicateVisitCount", "coverageRatio", "coverageEfficiency", "coverSemantics", "candidateOnly", "exactVerificationRequired"],
  "properties": {
    "resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
    "requiredCells": { "type": "array", "maxItems": 5000000, "uniqueItems": true, "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" } },
    "visitedCells": { "type": "array", "maxItems": 5000000, "uniqueItems": true, "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" } },
    "missingCells": { "type": "array", "maxItems": 5000000, "uniqueItems": true, "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" } },
    "duplicateCells": { "type": "array", "maxItems": 5000000, "uniqueItems": true, "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" } },
    "requiredCount": { "type": "integer", "minimum": 0 },
    "visitedRequiredCount": { "type": "integer", "minimum": 0 },
    "missingCount": { "type": "integer", "minimum": 0 },
    "duplicateVisitCount": { "type": "integer", "minimum": 0 },
    "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverageEfficiency": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverSemantics": { "const": "CENTER_CONTAINMENT_COVER" },
    "candidateOnly": { "const": true },
    "exactVerificationRequired": { "const": true }
  }
}
