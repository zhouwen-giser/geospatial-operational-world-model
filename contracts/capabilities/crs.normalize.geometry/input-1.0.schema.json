{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:crs.normalize.geometry:input:1.0",
  "title": "CrsNormalizeGeometryInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceCrs", "geometry"],
  "properties": {
    "sourceCrs": {
      "type": "string",
      "pattern": "^(?:[Ee][Pp][Ss][Gg]\\s*:\\s*[1-9][0-9]{0,5}|[Ww][Gg][Ss]\\s*84)$"
    },
    "geometry": { "$ref": "../geometry/geometry.schema.json" }
  }
}
