{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceCrs",
    "recognized",
    "kind",
    "traditionalGisInputOrder",
    "normalizationTarget",
    "operationAvailability"
  ],
  "properties": {
    "sourceCrs": {
      "type": "string",
      "pattern": "^EPSG:[1-9][0-9]{0,5}$"
    },
    "recognized": {
      "const": true
    },
    "kind": {
      "enum": [
        "geographic",
        "projected"
      ]
    },
    "traditionalGisInputOrder": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "normalizationTarget": {
      "const": "EPSG:4326"
    },
    "operationAvailability": {
      "const": "coordinate-and-grid-dependent"
    }
  },
  "$id": "urn:gowm:capability:crs.check-source:output:1.0",
  "title": "CrsCheckSourceOutputV1"
}
