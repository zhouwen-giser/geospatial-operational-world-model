{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:h3.hierarchy.uncompact:output:1.0",
  "title": "H3HierarchyUncompactOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolution", "cells"],
  "properties": {
    "resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
    "cells": {
      "type": "array",
      "maxItems": 5000000,
      "uniqueItems": true,
      "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/h3Cell" }
    }
  }
}
