{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:gowm.foundation.h3.project-point:input:1.0",
  "title": "GowmFoundationH3ProjectPointInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["point", "resolutions"],
  "properties": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 15 }
    }
  }
}
