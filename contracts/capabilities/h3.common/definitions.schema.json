{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:h3:definitions:1.0",
  "title": "H3BridgeDefinitionsV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "h3Cell": {
      "type": "string",
      "pattern": "^[0-9a-f]{15,16}$"
    },
    "resolution": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 15 },
        { "enum": ["GLOBAL", "REGIONAL", "CITY", "DISTRICT", "STREET", "FINE"] }
      ]
    },
    "geoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 }
      }
    },
    "h3CellValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "resolution"],
      "properties": {
        "index": { "$ref": "#/$defs/h3Cell" },
        "resolution": { "type": "integer", "minimum": 0, "maximum": 15 }
      }
    },
    "polygonal": {
      "oneOf": [
        { "$ref": "../geometry/geometry.schema.json#/$defs/polygon" },
        { "$ref": "../geometry/geometry.schema.json#/$defs/multiPolygon" }
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "resolution", "metric", "value"],
      "properties": {
        "cell": { "$ref": "#/$defs/h3Cell" },
        "resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
        "metric": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": "number" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "destination", "count"],
      "properties": {
        "origin": { "$ref": "#/$defs/h3Cell" },
        "destination": { "$ref": "#/$defs/h3Cell" },
        "count": { "type": "integer", "minimum": 0 },
        "weight": { "type": "number" }
      }
    },
    "trajectoryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["longitude", "latitude"],
      "properties": {
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "timestamp": { "type": "string", "format": "date-time" },
        "weight": { "type": "number" }
      }
    }
  }
}
