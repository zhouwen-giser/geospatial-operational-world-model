{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:h3.analytics.aggregate:output:1.0",
  "title": "H3AnalyticsAggregateOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolution", "metrics"],
  "properties": {
    "resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
    "metrics": {
      "type": "array",
      "maxItems": 5000000,
      "items": { "$ref": "../h3.common/definitions.schema.json#/$defs/metric" }
    }
  }
}
