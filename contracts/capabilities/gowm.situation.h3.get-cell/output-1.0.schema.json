{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:capability:gowm.situation.h3.get-cell:output:1.0",
  "title": "GowmSituationH3GetCellOutputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cells",
    "references",
    "candidateOnly",
    "exactVerificationRequired",
    "worldVersion",
    "metricProfile"
  ],
  "properties": {
    "cells": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "../gowm-situation-provider/definitions.schema.json#/$defs/cell" }
    },
    "references": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "../../platform/common-definitions.schema.json#/$defs/referenceKey" }
    },
    "candidateOnly": { "const": true },
    "exactVerificationRequired": { "const": true },
    "worldVersion": { "type": "integer", "minimum": 0 },
    "metricProfile": { "$ref": "../gowm-situation-provider/definitions.schema.json#/$defs/metricProfile" }
  }
}
