{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.6.3:grounding-core-promotion-policy",
  "title": "GroundingCorePromotionPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetVersion", "operations", "requiredGates"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "targetVersion": { "const": "0.6.3" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "operationVersion", "fromMaturity", "toMaturity"],
        "properties": {
          "operationId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "operationVersion": { "const": "1.0" },
          "fromMaturity": { "const": "PREVIEW" },
          "toMaturity": { "const": "STABLE" }
        }
      }
    },
    "requiredGates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
