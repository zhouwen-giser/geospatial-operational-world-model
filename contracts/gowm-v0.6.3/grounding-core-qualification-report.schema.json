{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.6.3:grounding-core-qualification-report",
  "title": "GroundingCoreQualificationReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceCommit", "operations", "status"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "operations": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "operationVersion", "gates", "status"],
        "properties": {
          "operationId": { "type": "string" },
          "operationVersion": { "type": "string" },
          "gates": { "type": "object", "additionalProperties": { "enum": ["PASS", "FAIL", "NOT_RUN"] } },
          "status": { "enum": ["PASS", "FAIL", "BLOCKED"] }
        }
      }
    },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] }
  }
}
