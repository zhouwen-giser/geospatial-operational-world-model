{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.5:network-condition-snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conditionSnapshotId",
    "graphVersion",
    "snapshotHash",
    "validFrom",
    "status"
  ],
  "properties": {
    "conditionSnapshotId": {
      "type": "string"
    },
    "graphVersion": {
      "type": "string"
    },
    "sourceWorldVersion": {
      "type": "integer",
      "minimum": 0
    },
    "validFrom": {
      "$ref": "network-common.schema.json#/$defs/dateTime"
    },
    "validTo": {
      "$ref": "network-common.schema.json#/$defs/dateTime"
    },
    "snapshotHash": {
      "$ref": "network-common.schema.json#/$defs/sha256"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "EXPIRED"
      ]
    },
    "conditionCount": {
      "type": "integer",
      "minimum": 0
    }
  }
}
