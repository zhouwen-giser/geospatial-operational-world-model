{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7:historical-gap",
  "title": "GowmV07HistoricalGap",
  "type": "object",
  "additionalProperties": false,
  "required": ["range", "reason"],
  "properties": {
    "range": { "$ref": "#/$defs/timeRange" },
    "reason": { "enum": ["UNKNOWN_INPUT_GAP", "SOURCE_COVERAGE_GAP", "TRACKLET_BOUNDARY_GAP"] },
    "details": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "bounds": { "const": "[)", "default": "[)" }
      }
    }
  }
}
