{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7:analysis-input-set",
  "title": "GowmV07AnalysisInputSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputSetReferenceKey", "inputSetKind", "itemCount", "itemSetDigest", "authority"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "inputSetReferenceKey": { "$ref": "#/$defs/inputSetReferenceKey" },
    "inputSetKind": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "itemCount": { "type": "integer", "minimum": 0 },
    "itemSetDigest": { "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest" },
    "authority": { "type": "string", "minLength": 1, "maxLength": 128 },
    "manifestArtifactReference": { "$ref": "#/$defs/artifactReference" }
  },
  "$defs": {
    "inputSetReferenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "const": "HISTORY_INPUT_SET" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "digest", "mediaType"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "digest": { "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
