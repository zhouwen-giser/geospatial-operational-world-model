{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7:historical-trajectory-query",
  "title": "GowmV07HistoricalTrajectoryQuery",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectReferenceKey", "executionIntervalReferenceKey", "phaseScope", "sourceSelection", "sourceSelectionProfileReferenceKey"],
  "properties": {
    "subjectReferenceKey": { "$ref": "../platform/common-definitions.schema.json#/$defs/referenceKey" },
    "executionIntervalReferenceKey": { "$ref": "#/$defs/executionIntervalReferenceKey" },
    "phaseScope": { "enum": ["EXECUTION_ENVELOPE", "ACTIVE_PHASES_ONLY"] },
    "sourceSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "sourceKey"],
          "properties": {
            "mode": { "const": "EXPLICIT_SOURCE" },
            "sourceKey": { "type": "string", "minLength": 1, "maxLength": 256 },
            "trackerSessionKey": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "ONLY_CANDIDATE" } }
        }
      ]
    },
    "sourceSelectionProfileReferenceKey": { "$ref": "#/$defs/methodProfileReferenceKey" },
    "analysisSpaceReferenceKey": { "$ref": "../platform/common-definitions.schema.json#/$defs/referenceKey" },
    "maximumInlinePoints": { "type": "integer", "minimum": 0, "maximum": 10000 }
  },
  "$defs": {
    "executionIntervalReferenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "const": "TASK_EXECUTION_INTERVAL" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "methodProfileReferenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "kind": { "const": "HISTORY_METHOD_PROFILE" },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
