{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:wsgs-sample-world:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "fixtureVersion",
    "namespace",
    "coordinateReferenceSystem",
    "epochPolicy",
    "scopes",
    "datasets",
    "features",
    "objects",
    "references",
    "observationTemplates",
    "mutations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gowm-wsgs-sample-world/1.0"
    },
    "fixtureId": {
      "const": "gowm-wsgs-sample-world"
    },
    "fixtureVersion": {
      "const": "1.0.0"
    },
    "namespace": {
      "type": "string"
    },
    "coordinateReferenceSystem": {
      "const": "EPSG:4326"
    },
    "epochPolicy": {
      "enum": [
        "LOAD_TIME_ANCHORED",
        "EXPLICIT_EPOCH"
      ]
    },
    "scopes": {
      "type": "array",
      "minItems": 2
    },
    "datasets": {
      "type": "array",
      "minItems": 3
    },
    "features": {
      "type": "array",
      "minItems": 1
    },
    "objects": {
      "type": "array",
      "minItems": 1
    },
    "references": {
      "type": "array",
      "minItems": 1
    },
    "observationTemplates": {
      "type": "array",
      "minItems": 1
    },
    "mutations": {
      "type": "array",
      "minItems": 1
    }
  }
}
