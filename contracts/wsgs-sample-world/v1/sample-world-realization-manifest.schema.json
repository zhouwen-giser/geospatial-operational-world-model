{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:wsgs-sample-world-realization:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "fixtureVersion",
    "sourceFixtureHash",
    "realizationId",
    "epoch",
    "generatedAt",
    "artifacts",
    "realizationHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "fixtureId": {
      "const": "gowm-wsgs-sample-world"
    },
    "fixtureVersion": {
      "const": "1.0.0"
    },
    "sourceFixtureHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "realizationId": {
      "type": "string"
    },
    "epoch": {
      "type": "string",
      "format": "date-time"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1
    },
    "realizationHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
