{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:wsgs-sample-instance-binding:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instanceId",
    "fixtureId",
    "fixtureVersion",
    "fixtureHash",
    "sourceFixtureHash",
    "realizationId",
    "realizationHash",
    "realizationT0",
    "loadedStateHash",
    "bindingRevision",
    "operationContracts",
    "canaryEvidencePath",
    "consumerConnectivityReportPath"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "instanceId": { "type": "string", "minLength": 1 },
    "fixtureId": { "const": "gowm-wsgs-sample-world" },
    "fixtureVersion": { "const": "1.0.0" },
    "fixtureHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceFixtureHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "realizationId": { "type": "string", "minLength": 1 },
    "realizationHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "realizationT0": { "type": "string", "format": "date-time" },
    "loadedStateHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bindingRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "operationContracts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "operationVersion", "inputSchemaHash", "outputSchemaHash", "semanticProfileHash", "maturity"],
        "properties": {
          "operationId": { "type": "string", "minLength": 3 },
          "operationVersion": { "const": "1.0" },
          "inputSchemaHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "outputSchemaHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "semanticProfileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "maturity": { "const": "STABLE" }
        }
      }
    },
    "canaryEvidencePath": { "const": "CANARY_EVIDENCE_REPORT.json" },
    "consumerConnectivityReportPath": { "const": "CONSUMER_CONNECTIVITY_REPORT.json" }
  }
}
