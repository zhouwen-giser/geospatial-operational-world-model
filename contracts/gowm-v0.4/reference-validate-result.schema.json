{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:reference-validate-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "results": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "referenceKey",
          "status",
          "revalidationRequired"
        ],
        "properties": {
          "referenceKey": {
            "$ref": "common.schema.json#/$defs/referenceKey"
          },
          "status": {
            "enum": [
              "VALID",
              "STALE",
              "EXPIRED",
              "NOT_FOUND",
              "TYPE_MISMATCH",
              "VERSION_CONFLICT",
              "SCOPE_DENIED"
            ]
          },
          "revalidationRequired": {
            "type": "boolean"
          },
          "descriptor": {
            "$ref": "reference-descriptor.schema.json"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
