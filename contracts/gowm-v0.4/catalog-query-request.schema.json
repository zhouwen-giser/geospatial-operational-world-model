{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:catalog-query-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "referenceKey": {
      "$ref": "common.schema.json#/$defs/referenceKey"
    },
    "types": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string"
      }
    },
    "query": {
      "type": "string",
      "maxLength": 512
    },
    "cursor": {
      "type": "string",
      "maxLength": 2048
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    }
  }
}
