{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7.1:trajectory-artifact-manifest",
  "title": "GowmTrajectoryArtifactManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion",
    "encoding",
    "coordinateEncoding",
    "trajectoryReferenceKey",
    "trajectoryContentHash",
    "inputSetHash",
    "worldVersion",
    "evaluationId",
    "analysisId",
    "fullRequestHash",
    "snapshotManifestHash",
    "frozenRequest",
    "frozenSnapshot",
    "geometryNodeCount",
    "evidenceSampleCount",
    "pageSize",
    "finalizationState",
    "temporalCoverageRatio",
    "prefixComplete",
    "suffixComplete",
    "requestedPeriods",
    "definedPeriods",
    "segments",
    "gaps",
    "excludedPeriods"
  ],
  "properties": {
    "type": {
      "const": "manifest"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "encoding": {
      "const": "PG_JSONB_NDJSON_V1"
    },
    "coordinateEncoding": {
      "const": "POSTGIS_GEOJSON_15_V1"
    },
    "trajectoryReferenceKey": {
      "$ref": "historical-trajectory-result.schema.json#/$defs/trajectoryReferenceKey"
    },
    "trajectoryContentHash": {
      "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest"
    },
    "inputSetHash": {
      "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest"
    },
    "worldVersion": {
      "type": "integer",
      "minimum": 0
    },
    "evaluationId": {
      "type": "string",
      "format": "uuid"
    },
    "analysisId": {
      "type": "string",
      "format": "uuid"
    },
    "fullRequestHash": {
      "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest"
    },
    "snapshotManifestHash": {
      "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest"
    },
    "frozenRequest": {
      "$ref": "../gowm-v0.7/historical-trajectory-query.schema.json"
    },
    "frozenSnapshot": {
      "$ref": "query-snapshot-manifest.schema.json"
    },
    "geometryNodeCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 250000
    },
    "evidenceSampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "pageSize": {
      "const": 256
    },
    "finalizationState": {
      "enum": [
        "PROVISIONAL",
        "SEALED",
        "CONFLICTED"
      ]
    },
    "temporalCoverageRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "prefixComplete": {
      "type": "boolean"
    },
    "suffixComplete": {
      "type": "boolean"
    },
    "requestedPeriods": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "bounds"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "bounds": {
            "enum": [
              "[]",
              "[)",
              "(]",
              "()"
            ]
          }
        }
      }
    },
    "definedPeriods": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "bounds"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "bounds": {
            "enum": [
              "[]",
              "[)",
              "(]",
              "()"
            ]
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmentNo",
          "sourceTrackletVersionId",
          "sourceSegmentNo",
          "geometryNodeCount",
          "evidenceSampleCount",
          "start",
          "end",
          "lowerInclusive",
          "upperInclusive",
          "interpolation"
        ],
        "properties": {
          "segmentNo": {
            "type": "integer",
            "minimum": 1
          },
          "sourceTrackletVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceSegmentNo": {
            "type": "integer",
            "minimum": 1
          },
          "geometryNodeCount": {
            "type": "integer",
            "minimum": 1
          },
          "evidenceSampleCount": {
            "type": "integer",
            "minimum": 0
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "lowerInclusive": {
            "type": "boolean"
          },
          "upperInclusive": {
            "type": "boolean"
          },
          "interpolation": {
            "enum": [
              "Linear",
              "Step",
              "Discrete"
            ]
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gapNo",
          "kind",
          "range",
          "reasonCodes"
        ],
        "properties": {
          "gapNo": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "UNKNOWN_INPUT_GAP",
              "SOURCE_COVERAGE_GAP",
              "TRACKLET_BOUNDARY_GAP"
            ]
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "bounds"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "bounds": {
                "enum": [
                  "[]",
                  "[)",
                  "(]",
                  "()"
                ]
              }
            }
          },
          "reasonCodes": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "excludedPeriods": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "range",
          "reason"
        ],
        "properties": {
          "range": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "bounds"
            ],
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string",
                "format": "date-time"
              },
              "bounds": {
                "enum": [
                  "[]",
                  "[)",
                  "(]",
                  "()"
                ]
              }
            }
          },
          "reason": {
            "const": "EXCLUDED_PAUSED_PHASE"
          }
        }
      }
    }
  }
}
