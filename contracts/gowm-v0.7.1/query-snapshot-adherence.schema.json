{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7.1:query-snapshot-adherence",
  "title": "GowmV071QuerySnapshotAdherence",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodeId", "status", "checkedResources"],
  "properties": {
    "nodeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "enum": ["MATCHED", "ADVANCED_COMPATIBLE", "MISMATCHED", "UNSUPPORTED", "NOT_APPLICABLE"] },
    "checkedResources": { "type": "integer", "minimum": 0 },
    "expectedConsistency": { "enum": ["PINNED", "CONSISTENT_AT_START", "BEST_EFFORT"] },
    "actualConsistency": { "enum": ["PINNED", "CONSISTENT_AT_START", "BEST_EFFORT"] },
    "expectedCapturedAt": { "type": "string", "format": "date-time" },
    "actualCapturedAt": { "type": "string", "format": "date-time" },
    "mismatches": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceKind", "resourceId", "reason"],
        "properties": {
          "resourceKind": { "type": "string", "minLength": 1, "maxLength": 128 },
          "resourceId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "expectedVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
          "actualVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
          "reason": { "enum": ["VERSION_MISMATCH", "CONTENT_HASH_MISMATCH", "WORLD_VERSION_TOO_OLD", "RESOURCE_MISSING", "PINNING_UNSUPPORTED", "CONSISTENCY_LEVEL_TOO_WEAK", "CAPTURED_AT_BEFORE_QUERY_BOUNDARY", "CAPTURED_AT_AFTER_QUERY_BOUNDARY", "CAPTURED_AT_MISMATCH", "PROVIDER_SNAPSHOT_TIME_INVALID", "NODE_NOT_EXECUTED", "LEGACY_ADHERENCE_NOT_RECORDED", "NODE_CANCELLED"] }
        }
      }
    }
  }
}
