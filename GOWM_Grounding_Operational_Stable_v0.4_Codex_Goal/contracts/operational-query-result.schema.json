{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:operational-query-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tasks",
    "truncated"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "tasks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "operational-task-snapshot.schema.json"
      }
    },
    "correlationFindings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "correlation-finding.schema.json"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "nextCursor": {
      "type": "string",
      "maxLength": 2048
    }
  }
}
