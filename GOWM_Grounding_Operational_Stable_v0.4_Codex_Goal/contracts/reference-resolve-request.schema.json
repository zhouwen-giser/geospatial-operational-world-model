{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:reference-resolve-request",
  "title": "ReferenceResolveRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mentions",
    "context",
    "limitPerMention"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "mentions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mentionId",
          "surfaceText"
        ],
        "properties": {
          "mentionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "surfaceText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expectedKinds": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          },
          "semanticRole": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchorReferenceKeys"
      ],
      "properties": {
        "anchorReferenceKeys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/referenceKey"
          }
        },
        "mapViewport": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "language": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "limitPerMention": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  }
}
