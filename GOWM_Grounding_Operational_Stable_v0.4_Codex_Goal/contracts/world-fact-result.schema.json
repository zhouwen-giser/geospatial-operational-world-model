{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:world-fact-result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "referenceKey",
    "worldVersion",
    "facts",
    "evidence",
    "unknowns"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "referenceKey": {
      "$ref": "common.schema.json#/$defs/referenceKey"
    },
    "worldVersion": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    }
  }
}
