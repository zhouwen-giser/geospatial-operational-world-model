{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.4:operational-task-event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "operationalTaskId",
    "eventType",
    "eventTime",
    "receivedTime",
    "actorReferenceKeys",
    "targetReferenceKeys",
    "payload",
    "provenance",
    "worldVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "operationalTaskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "eventType": {
      "enum": [
        "CONTROL_REQUEST_OBSERVED",
        "CONTROL_ACCEPTED_OBSERVED",
        "CONTROL_REJECTED_OBSERVED",
        "EXECUTION_STARTED_OBSERVED",
        "EXECUTION_PROGRESS_OBSERVED",
        "EXECUTION_PAUSED_OBSERVED",
        "EXECUTION_STOPPED_OBSERVED",
        "CONTROL_COMPLETED_REPORTED",
        "PHYSICAL_EFFECT_PARTIALLY_CONFIRMED",
        "PHYSICAL_EFFECT_CONFIRMED",
        "PHYSICAL_EFFECT_CONTRADICTED",
        "EXECUTION_FAILED_OBSERVED",
        "EXECUTION_CANCELLED_OBSERVED",
        "OBSERVATION_GAP_OPENED",
        "OBSERVATION_GAP_CLOSED"
      ]
    },
    "eventTime": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "receivedTime": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "subjectReferenceKey": {
      "$ref": "common.schema.json#/$defs/referenceKey"
    },
    "actorReferenceKeys": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/referenceKey"
      }
    },
    "targetReferenceKeys": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/referenceKey"
      }
    },
    "geometryRef": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/evidenceRef"
      }
    },
    "correlationClaims": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "external-correlation-claim.schema.json"
      }
    },
    "worldVersion": {
      "type": "integer",
      "minimum": 0
    }
  }
}
