# Deployment operator supplies the existing database. No global default device.
GOWM_DATABASE_URL=postgresql://ROLE:SECRET@HOST/EXISTING_GOWM_DATABASE
GOWM_BUSINESS_TEST_DATABASE_URL=postgresql://TEST_ROLE:SECRET@HOST/ISOLATED_TEST_DATABASE
GOWM_BUSINESS_SMOKE_ENABLE=false
# SMPP/Provider session: SET search_path TO ugv_smpp,public;
# SDAR session: SET search_path TO ugv_sdar,public;
# Disable consumer automatic migrations; verify GOWM manifest at startup.
# Explicit device bootstrap uses the deployment's actual source/endpoint config:
# UGV_MQTT_URL=mqtt://YOUR_BROKER:1883
# UGV_DEVICE_NAMESPACE=ugv
# UGV_DEVICE_ID=ugv  (external identifier, not the business master device_id)
# UGV_MQTT_ENDPOINT_KEY=ugv-default
# Optional real service bindings: SMPP_SERVICE_KEY, UGV_PROVIDER_ID, UGV_RESOURCE_ID,
# SDAR_SERVICE_KEY, SDAR_MCP_SERVER_ID. Unique-device fallback is scoped and persisted.
