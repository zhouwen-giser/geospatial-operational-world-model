    },
    {
      "id": "A13",
      "phase": "P4",
      "requirement": "原生根记录明确device归属，非设备全局记录不被强绑ugv1。",
      "verification": "database"
    },
    {
      "id": "A14",
      "phase": "P4",
      "requirement": "父子引用和Scope检查阻止跨设备关联。",
      "verification": "database"
    },
    {
      "id": "A15",
      "phase": "P4",
