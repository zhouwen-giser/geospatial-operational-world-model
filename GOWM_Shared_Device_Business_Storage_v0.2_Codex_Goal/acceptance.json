{
  "metadataFormat": "local-goal-acceptance/1.0",
  "items": [
    {
      "id": "A01",
      "phase": "P0",
      "requirement": "仅修改GOWM；记录实际来源和基线，不触碰消费者仓库。",
      "verification": "static"
    },
    {
      "id": "A02",
      "phase": "P1",
      "requirement": "固定共享ugv_smpp/ugv_sdar，不创建每设备/每实例业务Schema或business_store。",
      "verification": "static"
    },
    {
      "id": "A03",
      "phase": "P1",
      "requirement": "移除新公共合同中的store_id与数据库位置绑定；device_service_binding只描述逻辑服务。",
      "verification": "static"
    },
    {
      "id": "A04",
      "phase": "P2",
      "requirement": "设备主档复用world_object.id，Scope一致，改名不改设备身份。",
      "verification": "database"
    },
    {
      "id": "A05",
      "phase": "P2",
      "requirement": "MQTT入口复用既有source/datastream，配置解析能唯一确定设备，无全局ugv1默认。",
      "verification": "database"
    },
    {
      "id": "A06",
      "phase": "P2",
      "requirement": "服务/resource有效绑定唯一，多设备可合法共享MCP逻辑server。",
      "verification": "database"
    },
    {
      "id": "A07",
      "phase": "P2",
      "requirement": "更换绑定不改变历史任务与执行的device_id和原binding。",
