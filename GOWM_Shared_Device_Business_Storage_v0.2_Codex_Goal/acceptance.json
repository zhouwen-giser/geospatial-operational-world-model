    },
    {
      "id": "A19",
      "phase": "P4",
      "requirement": "同一执行并发claim不重复领取；worker重启不更换业务身份。",
      "verification": "database"
    },
    {
      "id": "A20",
      "phase": "P4",
      "requirement": "Lease键区分资源范围和owner；相同资源互斥，不同设备不误锁。",
      "verification": "database"
    },
    {
      "id": "A21",
      "phase": "P4",
      "requirement": "保留事务回滚、版本更新、Admission与Dispatch语义。",
