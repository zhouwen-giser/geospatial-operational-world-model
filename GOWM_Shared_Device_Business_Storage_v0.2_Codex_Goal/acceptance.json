      "verification": "database"
    },
    {
      "id": "A10",
      "phase": "P3",
      "requirement": "public对象、函数、序列、默认值、扩展引用正确转换；不污染GOWM public。",
      "verification": "database"
    },
    {
      "id": "A11",
