# Keep DATABASE_URL synchronized with POSTGRES_PASSWORD/POSTGRES_PORT when
# running Node commands from the host.
DATABASE_URL=postgresql://gowm:replace-with-the-same-random-password@localhost:5432/gowm
COMPOSE_PROJECT_NAME=gowm-plus-v1-2-change-to-a-utc-timestamp
POSTGRES_PASSWORD=replace-with-the-same-random-password
STAS_DB_PASSWORD=replace-with-a-different-random-password
HISTORICAL_WORKER_DB_PASSWORD=replace-with-a-third-distinct-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SHM_SIZE=1gb
MOBILITYDB_BASE_IMAGE=mobilitydb/mobilitydb:18-3.6-1.3@sha256:8409e3897e2b88561bef4374110c3da5f7ff56838a7745315f1c2f111305dd24
ANALYSIS_SRID=32650
ANALYSIS_SPACE_KEY=default
H3_PG_VERSION=4.5.0
MQTT_URL=mqtt://localhost:1883
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
API_BIND_ADDRESS=127.0.0.1
WORLD_API_PORT=3000
OBSERVATION_API_PORT=3002
STAS_PORT=8080
MCP_PORT=3001
WORLD_API_URL=http://localhost:3000
OBSERVATION_API_URL=http://localhost:3002
STALE_AFTER_MS=30000
MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_MESSAGE_EXPIRY_SEC=86400
SOURCE_PRIORITIES=camera:70,uav:80,ugv:75,sensor:60,operator:100,simulator:50
TRACKLET_MAX_TIME_GAP_MS=10000
TRACKLET_MAX_DISTANCE_GAP_M=250
TRACKLET_MAX_REQUIRED_SPEED_MPS=80

# Capability Platform P16 overlay. Never reuse these example values.
GATEWAY_DB_PASSWORD=replace_gateway_runtime_with_32_url_safe_chars
GATEWAY_REGISTRY_DB_PASSWORD=replace_registry_admin_with_32_url_safe_chars
SPATIAL_DB_PASSWORD=replace_spatial_reader_with_32_url_safe_chars
SITUATION_DB_PASSWORD=replace_situation_reader_with_32_url_safe_chars
GATEWAY_AUTH_SHARED_TOKEN=replace_gateway_transport_token_with_32_random_bytes
CRS_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_crs_provider_token_32_bytes
GEOMETRY_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_geometry_provider_token_32_bytes
H3_INTERACTIVE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_h3_interactive_token_32_bytes
H3_ANALYSIS_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_h3_analysis_token_32_bytes
SPATIAL_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_spatial_provider_token_32_bytes
SITUATION_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_situation_provider_token_32_bytes
SPATIAL_CURSOR_HMAC_SECRET=replace_spatial_cursor_secret_with_32_random_bytes
GATEWAY_RUNTIME_PRINCIPAL_REF=compose-runtime
GOWM_DATA_SCOPE_KEY=default
GATEWAY_PORT=8090
CRS_UPSTREAM_IMAGE=replace-with-local-crs-poc-image-not-for-redistribution
GEOMETRY_UPSTREAM_IMAGE=replace-with-local-geometry-poc-image-not-for-redistribution
H3_TOOLKIT_IMAGE=replace-with-immutable-h3-toolkit-image-at-locked-commit
H3_TOOLKIT_BINDINGS_MODULE_HOST_PATH=replace-with-absolute-path-to-approved-bindings-module
H3_TOOLKIT_BINDINGS_MODULE_SHA256=sha256:replace-with-approved-reproducible-bindings-artifact-sha256
CRS_PROJ_DB_VERSION=replace-with-deployed-proj-db-version
CRS_PROJ_DB_SHA256=sha256:replace-with-deployed-proj-db-sha256
CRS_GRID_BUNDLE_VERSION=replace-with-reviewed-grid-bundle-version-or-none
CRS_GRID_BUNDLE_SHA256=sha256:replace-with-reviewed-grid-bundle-sha256
