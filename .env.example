# Canonical development/deployment configuration template. The deploy script
# replaces secret placeholders and passes the resulting file to Compose
# explicitly. Published ports are intended only for a trusted LAN/VPN.
# Published service bind address. Host probes map 0.0.0.0 to 127.0.0.1 and ::
# to [::1]; a concrete IPv4/IPv6 address is probed directly.
DEV_BIND_ADDRESS=0.0.0.0
DEV_HEALTH_TIMEOUT_SECONDS=600
COMPOSE_PROJECT_NAME=gowm-plus-v1-2-change-to-a-utc-timestamp

# Foundation database. DATABASE_URL is for host-side Node commands and is kept
# synchronized with POSTGRES_PASSWORD/POSTGRES_PORT by the deploy script.
DATABASE_URL=postgresql://gowm:replace-with-the-same-random-password@localhost:5432/gowm
POSTGRES_PASSWORD=replace-with-the-same-random-password
STAS_DB_PASSWORD=replace-with-a-different-random-password
HISTORICAL_WORKER_DB_PASSWORD=replace-with-a-third-distinct-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SHM_SIZE=1gb
MOBILITYDB_BASE_IMAGE=mobilitydb/mobilitydb:18-3.6-1.3@sha256:8409e3897e2b88561bef4374110c3da5f7ff56838a7745315f1c2f111305dd24
WORLD_PLATFORM_POSTGRES_IMAGE=gowm-plus-db:18-3.6-mobilitydb-1.3-h3-4.5.0-pgrouting-4.0.1
PGROUTING_VERSION=4.0.1
ANALYSIS_SRID=32650
ANALYSIS_SPACE_KEY=default
H3_PG_VERSION=4.5.0
MQTT_URL=mqtt://localhost:1883
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
API_BIND_ADDRESS=127.0.0.1
WORLD_API_PORT=3000
OBSERVATION_API_PORT=3002
STAS_PORT=8080
LOG_LEVEL=info
DB_POOL_SIZE=20
SERVICE_NAME=gowm
SERVICE_REVISION=dev
STAS_DB_POOL_MAX=20
STAS_DB_CONNECTION_TIMEOUT_MS=2000
MCP_PORT=3001
WORLD_API_URL=http://localhost:3000
OBSERVATION_API_URL=http://localhost:3002
STALE_AFTER_MS=30000
DEFAULT_H3_RESOLUTION=9
MAX_FUTURE_SKEW_MS=300000
MAX_LATE_ARRIVAL_MS=86400000
MQTT_CONNECT_TIMEOUT_MS=5000
MQTT_MESSAGE_EXPIRY_SEC=86400
POSITION_TRANSFORM_TOLERANCE_M=0.05

# Optional single-UGV reliable MQTT ingest profile (`docker compose --profile
# ugv-mqtt up -d`). Never commit credentials. The source schema directory must
# contain generated mqtt_topics.json, mcp_ugv.json and error_codes.json and is
# mounted read-only. File-based TLS/password paths require a deployment-specific
# Compose override mounting each host file at the configured container path.
UGV_MQTT_INGEST_ENABLED=false
UGV_MQTT_URL=mqtt://replace-with-source-broker:1883
UGV_MQTT_CLIENT_ID=gowm-ugv-ingest-airport-01
UGV_MQTT_USERNAME=
UGV_MQTT_PASSWORD_FILE=
UGV_MQTT_PASSWORD_CONTAINER_FILE=
UGV_MQTT_CA_FILE=
UGV_MQTT_CA_CONTAINER_FILE=
UGV_MQTT_CERT_FILE=
UGV_MQTT_CERT_CONTAINER_FILE=
UGV_MQTT_KEY_FILE=
UGV_MQTT_KEY_CONTAINER_FILE=
UGV_MQTT_SESSION_EXPIRY_SECONDS=86400
UGV_MQTT_KEEPALIVE_SECONDS=30
UGV_MQTT_CONNECT_TIMEOUT_MS=5000
# MQTT v5 server-to-client in-flight QoS 1 window. Keep 1 for strict durable ACK ordering.
UGV_MQTT_RECEIVE_MAXIMUM=1
UGV_MQTT_MAX_PAYLOAD_BYTES=1048576
# Fail closed and disconnect before accepting another QoS1 message when the
# durable, not-yet-delivered inbox reaches this bound.
UGV_MQTT_MAX_PENDING_INBOX=10000
# Reject the complete target frame (never truncate it) above this source limit.
UGV_MQTT_MAX_TARGETS_PER_FRAME=256
UGV_MQTT_HTTP_TIMEOUT_MS=5000
UGV_EQUIPMENT_SCHEMA_DIR=/absolute/path/to/isr-simulation/doc/equipment/schema
UGV_DEVICE_ID=ugv
UGV_DATA_SCOPE_KEY=airport-sim-ugv-01
UGV_ORIGIN_KIND=SIMULATION
UGV_SOURCE_KEY=ugv-airport-sim-mqtt
UGV_PRODUCER_PIPELINE_KEY=ugv-airport-sim-mqtt:canonical-v1
UGV_SCENARIO_ID=airport
UGV_WORLD_EPOCH=airport-run-001
UGV_TRACKER_SESSION_KEY=airport-run-001:ugv
UGV_ANALYSIS_SPACE_KEY=airport-utm48n
UGV_ANALYSIS_SRID=32648
UGV_MQTT_ARRIVAL_TIME_UNCERTAINTY_MS=1000
UGV_MQTT_SAMPLING_POLICY_VERSION=ugv-authority-sampling-v1
UGV_MQTT_GNSS_MIN_INTERVAL_MS=500
UGV_MQTT_GNSS_FORCE_DISPLACEMENT_M=0.5
UGV_MQTT_GNSS_HEARTBEAT_MS=5000
UGV_MQTT_SPEED_MIN_INTERVAL_MS=500
UGV_MQTT_SPEED_FORCE_DELTA_MPS=0.2
UGV_MQTT_PLATFORM_MIN_INTERVAL_MS=1000
UGV_MQTT_CHASSIS_PROGRESS_DELTA_PERCENT=5
UGV_MQTT_CHASSIS_HEARTBEAT_MS=5000
UGV_MQTT_RECON_MIN_INTERVAL_MS=1000
UGV_MQTT_RECON_COVERAGE_DELTA_PERCENT=1
UGV_MQTT_TARGET_MIN_INTERVAL_MS=500
UGV_MQTT_INGEST_PORT=3010
GOWM_OBSERVATION_API_URL=http://observation-ingest:3002
SOURCE_PRIORITIES=camera:70,uav:80,ugv:75,sensor:60,operator:100,simulator:50
TRACKLET_MAX_TIME_GAP_MS=10000
TRACKLET_MAX_DISTANCE_GAP_M=250
TRACKLET_MAX_REQUIRED_SPEED_MPS=80
HISTORICAL_PROJECTION_RETRY_DELAY_MS=1000
HISTORICAL_PROJECTION_MAX_RETRY_DELAY_MS=60000
HISTORICAL_PROJECTION_BACKOFF_MULTIPLIER=2
PROJECTION_BATCH_SIZE=200
PROJECTION_POLL_MS=250
WORLD_API_COMPATIBILITY_MODE=legacy
# Optional ISO-8601 sunset and JSON parity attestations; blank disables them.
WORLD_API_COMPATIBILITY_SUNSET=
WORLD_API_PARITY_ATTESTATIONS_JSON=
SIM_VEHICLES=100
SIM_RATE_HZ=1

# Capability Platform P16 overlay. Never reuse these example values.
GATEWAY_DB_PASSWORD=replace_gateway_runtime_with_32_url_safe_chars
GATEWAY_REGISTRY_DB_PASSWORD=replace_registry_admin_with_32_url_safe_chars
SPATIAL_DB_PASSWORD=replace_spatial_reader_with_32_url_safe_chars
SITUATION_DB_PASSWORD=replace_situation_reader_with_32_url_safe_chars
REFERENCE_DB_PASSWORD=replace_reference_reader_with_32_url_safe_chars
CATALOG_DB_PASSWORD=replace_catalog_reader_with_32_url_safe_chars
EVIDENCE_DB_PASSWORD=replace_evidence_reader_with_32_url_safe_chars
OPERATIONAL_DB_PASSWORD=replace_operational_reader_with_32_url_safe_chars
HISTORICAL_DB_PASSWORD=replace_historical_reader_with_32_url_safe_chars
VALIDATION_DB_PASSWORD=replace_validation_reader_with_32_url_safe_chars
NETWORK_DB_PASSWORD=replace_network_reader_with_32_url_safe_chars
ROUTE_DB_PASSWORD=replace_route_reader_with_32_url_safe_chars
COVERAGE_DB_PASSWORD=replace_coverage_reader_with_32_url_safe_chars
GATEWAY_AUTH_SHARED_TOKEN=replace_gateway_transport_token_with_32_random_bytes
GATEWAY_AUTH_MODE=STATIC_SERVICE
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_DATA_SCOPE_CLAIM=default
GATEWAY_DATASET_SCOPE_CLAIM=default
GATEWAY_DELEGATION_ISSUER=
GATEWAY_DELEGATION_AUDIENCE=
GATEWAY_DELEGATION_PUBLIC_KEY=
GATEWAY_DELEGATION_MAX_TTL_SECONDS=300
GATEWAY_ID=gowm-capability-gateway
GATEWAY_POLICY_VERSION=gowm-capability-policy:0.7.1-dev
GATEWAY_ATTESTATION_ISSUER=gowm-capability-gateway
GATEWAY_ALLOW_EXPERIMENTAL=false
GATEWAY_QUERY_WORKER_POLL_MS=1000
GATEWAY_QUERY_WORKER_LEASE_SECONDS=600
GATEWAY_QUERY_WORKER_MAX_CLAIMS=8
GROUNDING_CURSOR_HMAC_SECRET=replace_grounding_cursor_secret_with_32_random_bytes
CRS_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_crs_provider_token_32_bytes
GEOMETRY_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_geometry_provider_token_32_bytes
DATASET_CATALOG_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_dataset_catalog_token_32_bytes
NETWORK_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_network_provider_token_32_bytes
OPERATIONAL_REALITY_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_operational_provider_token_32_bytes
HISTORICAL_TRACE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_historical_provider_token_32_bytes
PLATFORM_VALIDATION_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_validation_provider_token_32_bytes
REFERENCE_CATALOG_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_reference_catalog_token_32_bytes
COVERAGE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_coverage_provider_token_32_bytes
ROUTE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_route_provider_token_32_bytes
STAS_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_stas_provider_token_32_bytes
WORLD_EVIDENCE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_evidence_provider_token_32_bytes
H3_INTERACTIVE_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_h3_interactive_token_32_bytes
H3_ANALYSIS_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_h3_analysis_token_32_bytes
SPATIAL_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_spatial_provider_token_32_bytes
SITUATION_PROVIDER_TRANSPORT_TOKEN=replace_with_unique_situation_provider_token_32_bytes
SPATIAL_CURSOR_HMAC_SECRET=replace_spatial_cursor_secret_with_32_random_bytes
SPATIAL_POSTGIS_VERSION=3.6.4
# Provider pool, timeout and bounded-result controls.
GROUNDING_CATALOG_POOL_SIZE=8
GROUNDING_CATALOG_STATEMENT_TIMEOUT_MS=5000
GROUNDING_CATALOG_LOCK_TIMEOUT_MS=1000
GROUNDING_CATALOG_MAXIMUM_ROWS=1000
GROUNDING_CATALOG_MAXIMUM_CANDIDATES=5000
SPATIAL_POOL_SIZE=8
SPATIAL_STATEMENT_TIMEOUT_MS=5000
SPATIAL_LOCK_TIMEOUT_MS=1000
SPATIAL_MAXIMUM_ROWS=10000
SPATIAL_MAXIMUM_CANDIDATES=50000
SPATIAL_MAXIMUM_EVIDENCE_REFERENCES=1000
NETWORK_PROVIDER_POOL_SIZE=8
NETWORK_PROVIDER_STATEMENT_TIMEOUT_MS=10000
NETWORK_PROVIDER_LOCK_TIMEOUT_MS=1000
NETWORK_PROVIDER_MAXIMUM_SEGMENTS=100000
NETWORK_PROVIDER_MAXIMUM_MATRIX_POINTS=64
HISTORICAL_TRACE_POOL_SIZE=8
PLATFORM_VALIDATION_POOL_SIZE=8
PLATFORM_VALIDATION_STATEMENT_TIMEOUT_MS=5000
GATEWAY_RUNTIME_PRINCIPAL_REF=compose-runtime
GOWM_DATA_SCOPE_KEY=default
GATEWAY_PORT=8090
# Optional image-name overrides. Compose builds both MIT upstreams from the
# repository by default; these values only name/tag the resulting images.
CRS_UPSTREAM_IMAGE=gowm-crs-normalization-service:1.0.0
GEOMETRY_UPSTREAM_IMAGE=gowm-geometry-tool-service:1.0.0
CRS_MAX_POINTS=100000
CRS_MAX_VERTICES=100000
CRS_MAX_REQUEST_BYTES=16777216
CRS_REQUEST_TIMEOUT_MS=30000
CRS_UPSTREAM_PIDS_LIMIT=256
CRS_UPSTREAM_CPUS=1.0
CRS_UPSTREAM_MEMORY_LIMIT=1g
GEOMETRY_WORKERS=2
GEOMETRY_LOGGER=true
GEOMETRY_MAX_IN_FLIGHT=32
GEOMETRY_MAX_QUEUE_SIZE=128
GEOMETRY_UPSTREAM_PIDS_LIMIT=256
GEOMETRY_UPSTREAM_CPUS=2.0
GEOMETRY_UPSTREAM_MEMORY_LIMIT=2g
H3_TOOLKIT_IMAGE=replace-with-immutable-h3-toolkit-image-at-locked-commit
H3_TOOLKIT_BINDINGS_MODULE_HOST_PATH=/absolute/path/to/approved/h3-bindings.mjs
H3_TOOLKIT_BINDINGS_HOST_PATH=/absolute/path/to/approved/h3-bindings.mjs
H3_TOOLKIT_BINDINGS_MODULE_SHA256=sha256:replace-with-approved-reproducible-bindings-artifact-sha256
CRS_PROJ_DB_VERSION=replace-with-deployed-proj-db-version
CRS_PROJ_DB_SHA256=sha256:replace-with-deployed-proj-db-sha256
CRS_GRID_BUNDLE_VERSION=replace-with-reviewed-grid-bundle-version-or-none
CRS_GRID_BUNDLE_SHA256=sha256:replace-with-reviewed-grid-bundle-sha256

# Development-only published host ports. Container-internal ports stay fixed.
CRS_UPSTREAM_PUBLISHED_PORT=18080
GEOMETRY_UPSTREAM_PUBLISHED_PORT=18081
CRS_BRIDGE_PUBLISHED_PORT=18086
GEOMETRY_BRIDGE_PUBLISHED_PORT=18087
H3_INTERACTIVE_PUBLISHED_PORT=18088
H3_ANALYSIS_PUBLISHED_PORT=18089
REFERENCE_PROVIDER_PUBLISHED_PORT=18090
DATASET_PROVIDER_PUBLISHED_PORT=18091
SITUATION_PROVIDER_PUBLISHED_PORT=18092
EVIDENCE_PROVIDER_PUBLISHED_PORT=18093
OPERATIONAL_PROVIDER_PUBLISHED_PORT=18094
VALIDATION_PROVIDER_PUBLISHED_PORT=18095
NETWORK_PROVIDER_PUBLISHED_PORT=18096
ROUTE_PROVIDER_PUBLISHED_PORT=18097
COVERAGE_PROVIDER_PUBLISHED_PORT=18098
STAS_PROVIDER_PUBLISHED_PORT=18099
HISTORICAL_PROVIDER_PUBLISHED_PORT=18100
SPATIAL_PROVIDER_PUBLISHED_PORT=18101

# Optional checkout used only when the approved H3 artifact is absent.
H3_SOURCE_REPO=

# OpenDRIVE management-plane compiler/admission. The command may point to the
# repository wrapper or an equivalent containerized entrypoint. Admission is a
# dry-run unless ALLOW_DB_MUTATION is exactly YES; a write additionally requires
# GOWM_OPENDRIVE_DATABASE_URL and the exact fingerprint returned by the read-only
# `admit --show-db-fingerprint` command. The Docker network defaults to `host` so
# a Linux development host can reach its locally published DB/Provider ports.
GOWM_OPENDRIVE_COMMAND=./scripts/opendrive-task-network.sh
GOWM_OPENDRIVE_IMAGE=gowm-opendrive-task-network:0.7.1
GOWM_OPENDRIVE_DOCKER_NETWORK=host
OPENDRIVE_SOURCE_PATH=/absolute/path/to/airport2.xodr
OPENDRIVE_GEOREF_ORACLE_PATH=/absolute/path/to/gnss_transform.py
GOWM_OPENDRIVE_OUTPUT_ROOT=/absolute/path/to/opendrive-task-network-v0.1/artifacts
GOWM_OPENDRIVE_DATA_SCOPE_KEY=opendrive-acceptance
GOWM_OPENDRIVE_DATASET_SCOPE_KEY=airport2-task-network
GOWM_OPENDRIVE_GRAPH_KEY=airport2-task-network-v1
GOWM_OPENDRIVE_DATABASE_URL=
GOWM_OPENDRIVE_EXPECTED_DB_FINGERPRINT=
GOWM_OPENDRIVE_ALLOW_DB_MUTATION=NO
# The fixed `gowm` development database needs this second switch plus matching
# expected/actual Compose project identities. Leave the switch at NO for normal
# one-time `gowm_opendrive_*` acceptance databases.
GOWM_OPENDRIVE_ALLOW_DEVELOPMENT_DATABASE=NO
GOWM_OPENDRIVE_EXPECTED_COMPOSE_PROJECT=gowm-plus-v1-2-change-to-a-utc-timestamp
# Real Provider verification values are secret-bearing runtime inputs; the
# wrapper passes them to Docker by variable name and never writes them to reports.
GOWM_OPENDRIVE_NETWORK_PROVIDER_URL=
GOWM_OPENDRIVE_NETWORK_PROVIDER_TOKEN=
