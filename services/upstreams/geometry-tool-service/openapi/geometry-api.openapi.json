{
  "openapi": "3.1.0",
  "info": {
    "title": "Geospatial Geometry Service API",
    "version": "1.0.0",
    "description": "Contract-first planar geometry operations. SRID is metadata only; no reprojection or geodesic semantics are provided."
  },
  "servers": [{ "url": "http://localhost:8080" }],
  "tags": [{ "name": "Geometry" }, { "name": "Operations" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": { "200": { "description": "Process is live", "content": { "application/json": { "schema": { "type": "object" }, "example": { "status": "ok", "service": "geometry-api" } } } } }
      }
    },
    "/ready": {
      "get": {
        "operationId": "ready",
        "responses": {
          "200": { "description": "Engine is initialized", "content": { "application/json": { "schema": { "type": "object" }, "example": { "status": "ready", "engine": "GEOS-WASM-WORKER-POOL", "engineVersion": "3.13.0-CAPI-1.19.0", "database": "not-required", "overloadProtection": { "maxInFlight": 64, "workerPool": { "workers": 2, "readyWorkers": 2, "activeRequests": 0, "queuedRequests": 0, "maxQueueSize": 256, "totalCapacity": 258, "closing": false } } } } } },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/metrics": {
      "get": { "operationId": "metrics", "responses": { "200": { "description": "Prometheus metrics", "content": { "text/plain": { "schema": { "type": "string" } } } } } }
    },
    "/openapi.json": {
      "get": { "operationId": "openapi", "responses": { "200": { "description": "This OpenAPI document", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/v1/geometry/validate": {
      "post": {
        "tags": ["Geometry"], "operationId": "validateGeometry", "summary": "Validate one geometry with OGC/GEOS semantics",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnaryRequest" }, "example": { "input": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[2,2],[0,2],[2,0],[0,0]]] }, "srid": 4326 } } } } },
        "responses": { "200": { "description": "Validity and diagnostic location", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationResult" }, "example": { "result": false, "detail": { "valid": false, "reason": "Self-intersection", "location": { "type": "Point", "coordinates": [1,1] }, "simple": false, "empty": false, "closed": null, "ring": null, "rectangle": false }, "summary": { "type": "Polygon", "empty": false, "vertexCount": 5, "coordinateDimension": 2, "valid": false }, "warnings": [], "execution": { "engine": "GEOS-WASM", "engineVersion": "3.13.0-CAPI-1.19.0", "durationMs": 1.2, "operation": "validate", "deterministicScope": "engine-version-input-options" } } } } }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/make-valid": {
      "post": {
        "tags": ["Geometry"], "operationId": "makeGeometryValid", "summary": "Repair invalid geometry explicitly",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnaryRequest" }, "example": { "input": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[2,2],[0,2],[2,0],[0,0]]] } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/buffer": {
      "post": {
        "tags": ["Operations"], "operationId": "bufferGeometry", "summary": "Planar buffer in input coordinate-space units",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BufferRequest" }, "example": { "input": { "geometry": { "type": "Point", "coordinates": [10,20] }, "srid": 3857 }, "options": { "distance": 500, "quadrantSegments": 8, "endCapStyle": "round", "joinStyle": "round", "mitreLimit": 5, "singleSided": false } } } } },
        "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/intersection": { "post": { "tags": ["Operations"], "operationId": "intersectGeometries", "summary": "Topological intersection", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/geometry/union": { "post": { "tags": ["Operations"], "operationId": "unionGeometries", "summary": "Topological union", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/geometry/difference": { "post": { "tags": ["Operations"], "operationId": "differenceGeometries", "summary": "A minus B", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } } } },
    "/v1/geometry/simplify": {
      "post": {
        "tags": ["Operations"], "operationId": "simplifyGeometry", "summary": "Simplify, topology-preserving by default",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SimplifyRequest" }, "example": { "input": { "geometry": { "type": "LineString", "coordinates": [[0,0],[0.1,0.01],[0.2,0],[1,0]] } }, "options": { "tolerance": 0.05, "preserveTopology": true } } } } },
        "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/measure": {
      "post": {
        "tags": ["Operations"], "operationId": "measureGeometry", "summary": "Planar area, length, distance, Hausdorff distance or minimum clearance",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeasureRequest" }, "example": { "measure": "area", "input": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[10,0],[10,5],[0,5],[0,0]]] }, "srid": 3857 } } } } },
        "responses": { "200": { "$ref": "#/components/responses/ScalarResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/predicate": {
      "post": {
        "tags": ["Operations"], "operationId": "testGeometryPredicate", "summary": "OGC topological predicate or DE-9IM relate",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PredicateRequest" }, "example": { "predicate": "contains", "a": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[5,0],[5,5],[0,5],[0,0]]] } }, "b": { "geometry": { "type": "Point", "coordinates": [2,2] } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/ScalarResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/batch": {
      "post": {
        "tags": ["Operations"], "operationId": "batchGeometryOperation", "summary": "Ordered batch with per-item errors",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchRequest" }, "example": { "operation": "validate", "continueOnError": true, "items": [{ "input": { "geometry": { "type": "Point", "coordinates": [0,0] } } }, { "input": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[2,2],[0,2],[2,0],[0,0]]] } } }] } } } },
        "responses": { "200": { "description": "Batch result in input order", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BatchResult" } } } }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/parse": {
      "post": {
        "tags": ["Geometry"], "operationId": "parseGeometry", "summary": "Parse GeoJSON geometry, WKT or hexadecimal WKB/EWKB",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["format","value"], "properties": { "format": { "enum": ["geojson","wkt","wkb-hex"] }, "value": {}, "srid": { "type": "integer", "minimum": 0 } } }, "example": { "format": "wkt", "value": "POINT (1 2)", "srid": 4326 } } } },
        "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/serialize": {
      "post": {
        "tags": ["Geometry"], "operationId": "serializeGeometry", "summary": "Serialize geometry as GeoJSON, WKT or hexadecimal WKB/EWKB",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["input","format"], "properties": { "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "format": { "enum": ["geojson","wkt","wkb-hex"] } } }, "example": { "input": { "geometry": { "type": "Point", "coordinates": [1,2] }, "srid": 4326 }, "format": "wkt" } } } },
        "responses": { "200": { "$ref": "#/components/responses/ScalarResult" }, "422": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    },
    "/v1/geometry/execute": {
      "post": {
        "tags": ["Operations"], "operationId": "executeGeometryOperation", "summary": "Neutral operation endpoint for P1 operators",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationRequest" }, "example": { "operation": "centroid", "input": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[2,0],[2,2],[0,2],[0,0]]] } } } } } },
        "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "400": { "$ref": "#/components/responses/Error" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" }, "503": { "$ref": "#/components/responses/Error" } }
      }
    }
  },
  "components": {
    "pathItems": {
      "BinaryIntersection": { "post": { "tags": ["Operations"], "operationId": "intersectGeometries", "summary": "Topological intersection", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" } } } },
      "BinaryUnion": { "post": { "tags": ["Operations"], "operationId": "unionGeometries", "summary": "Topological union", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" } } } },
      "BinaryDifference": { "post": { "tags": ["Operations"], "operationId": "differenceGeometries", "summary": "A minus B", "requestBody": { "$ref": "#/components/requestBodies/Binary" }, "responses": { "200": { "$ref": "#/components/responses/GeometryResult" }, "422": { "$ref": "#/components/responses/Error" }, "413": { "$ref": "#/components/responses/Error" } } } }
    },
    "requestBodies": {
      "Binary": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BinaryRequest" }, "example": { "a": { "geometry": { "type": "Polygon", "coordinates": [[[0,0],[4,0],[4,4],[0,4],[0,0]]] } }, "b": { "geometry": { "type": "Polygon", "coordinates": [[[2,2],[6,2],[6,6],[2,6],[2,2]]] } }, "options": { "precision": { "gridSize": 0.001 } } } } } }
    },
    "responses": {
      "GeometryResult": { "description": "Geometry plus metadata, warnings and engine provenance", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GeometryResult" }, "example": { "result": { "type": "Polygon", "coordinates": [[[2,2],[4,2],[4,4],[2,4],[2,2]]] }, "summary": { "type": "Polygon", "empty": false, "valid": true, "vertexCount": 5, "coordinateDimension": 2, "units": "coordinate-space" }, "warnings": [], "execution": { "engine": "GEOS-WASM", "engineVersion": "3.13.0-CAPI-1.19.0", "durationMs": 2.1, "operation": "intersection", "deterministicScope": "engine-version-input-options" } } } } },
      "ScalarResult": { "description": "Scalar result with explicit units", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScalarResult" }, "example": { "result": 50, "summary": { "units": "coordinate-space-squared" }, "warnings": [], "execution": { "engine": "GEOS-WASM", "engineVersion": "3.13.0-CAPI-1.19.0", "durationMs": 0.5, "operation": "area", "deterministicScope": "engine-version-input-options" } } } } },
      "Error": { "description": "Uniform error envelope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" }, "example": { "error": { "code": "INVALID_GEOMETRY", "message": "Self-intersection", "operation": "intersection", "recoverable": true, "suggestion": "Call geometry.make_valid explicitly, or use lenient mode with repairInvalid=true." } } } } }
    },
    "schemas": {
      "Position": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "number" } },
      "Geometry": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["Point","MultiPoint","LineString","MultiLineString","Polygon","MultiPolygon","GeometryCollection"] },
          "coordinates": { "type": "array" },
          "geometries": { "type": "array", "items": { "$ref": "#/components/schemas/Geometry" } }
        },
        "additionalProperties": false
      },
      "Feature": { "type": "object", "required": ["type","geometry","properties"], "properties": { "type": { "const": "Feature" }, "geometry": { "$ref": "#/components/schemas/Geometry" }, "properties": { "type": ["object","null"] }, "id": { "type": ["string","number"] } }, "additionalProperties": false },
      "Precision": { "type": "object", "required": ["gridSize"], "properties": { "gridSize": { "type": "number", "exclusiveMinimum": 0 }, "keepCollapsed": { "type": "boolean", "default": false } }, "additionalProperties": false },
      "CommonOptions": { "type": "object", "properties": { "mode": { "enum": ["strict","lenient"], "default": "strict" }, "repairInvalid": { "type": "boolean", "default": false }, "normalizeOutput": { "type": "boolean", "default": false }, "precision": { "$ref": "#/components/schemas/Precision" }, "planar": { "type": "boolean", "default": false }, "outputFormat": { "enum": ["geojson","wkt","wkb-hex"], "default": "geojson" } }, "additionalProperties": false },
      "GeometryEnvelope": { "type": "object", "required": ["geometry"], "properties": { "geometry": { "oneOf": [{ "$ref": "#/components/schemas/Geometry" }, { "$ref": "#/components/schemas/Feature" }] }, "srid": { "type": "integer", "minimum": 0, "description": "Metadata only; never triggers reprojection." }, "coordinateLayout": { "enum": ["XY","XYZ","XYM","XYZM"] }, "options": { "$ref": "#/components/schemas/CommonOptions" } }, "additionalProperties": false },
      "UnaryRequest": { "type": "object", "required": ["input"], "properties": { "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "options": { "$ref": "#/components/schemas/CommonOptions" } }, "additionalProperties": false },
      "BinaryRequest": { "type": "object", "required": ["a","b"], "properties": { "a": { "$ref": "#/components/schemas/GeometryEnvelope" }, "b": { "$ref": "#/components/schemas/GeometryEnvelope" }, "options": { "$ref": "#/components/schemas/CommonOptions" } }, "additionalProperties": false },
      "BufferRequest": { "type": "object", "required": ["input","options"], "properties": { "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "options": { "allOf": [{ "$ref": "#/components/schemas/CommonOptions" }, { "type": "object", "required": ["distance"], "properties": { "distance": { "type": "number" }, "quadrantSegments": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8 }, "endCapStyle": { "enum": ["round","flat","square"] }, "joinStyle": { "enum": ["round","mitre","bevel"] }, "mitreLimit": { "type": "number", "exclusiveMinimum": 0 }, "singleSided": { "type": "boolean" } } }] } }, "additionalProperties": false },
      "SimplifyRequest": { "type": "object", "required": ["input","options"], "properties": { "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "options": { "allOf": [{ "$ref": "#/components/schemas/CommonOptions" }, { "type": "object", "required": ["tolerance"], "properties": { "tolerance": { "type": "number", "minimum": 0 }, "preserveTopology": { "type": "boolean", "default": true }, "preserveCoverageBoundary": { "type": "boolean", "default": true } } }] } }, "additionalProperties": false },
      "MeasureRequest": { "type": "object", "required": ["measure","input"], "properties": { "measure": { "enum": ["area","length","distance","hausdorff_distance","minimum_clearance"] }, "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "other": { "$ref": "#/components/schemas/GeometryEnvelope" }, "options": { "$ref": "#/components/schemas/CommonOptions" } }, "additionalProperties": false },
      "PredicateRequest": { "allOf": [{ "$ref": "#/components/schemas/BinaryRequest" }, { "type": "object", "required": ["predicate"], "properties": { "predicate": { "enum": ["equals","disjoint","intersects","touches","crosses","within","contains","overlaps","covers","covered_by","relate"] }, "pattern": { "type": "string", "pattern": "^[012TF*]{9}$" } } }] },
      "GeometryOperation": { "type": "string", "enum": ["parse_geojson","parse_wkt","parse_wkb","to_geojson","to_wkt","to_wkb","validate","make_valid","remove_repeated_points","normalize","orient_polygon","force_2d","buffer","intersection","union","difference","symmetric_difference","unary_union","coverage_union","equals","disjoint","intersects","touches","crosses","within","contains","overlaps","covers","covered_by","relate","area","length","distance","hausdorff_distance","minimum_clearance","simplify","simplify_preserve_topology","coverage_simplify","snap","reduce_precision","centroid","point_on_surface","bounding_box","convex_hull","concave_hull","line_merge","reverse","substring","interpolate_point","project_point","closest_point","shortest_line","polygonize","boundary","minimum_rotated_rectangle","collect","explode","geometry_hash","reproject","geodesic_distance","geodesic_area","geodesic_length","spatial_join","rasterize","shortest_path","h3_polyfill"] },
      "OperationRequest": { "type": "object", "required": ["operation"], "properties": { "operation": { "$ref": "#/components/schemas/GeometryOperation" }, "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "other": { "$ref": "#/components/schemas/GeometryEnvelope" }, "inputs": { "type": "array", "items": { "$ref": "#/components/schemas/GeometryEnvelope" } }, "parameters": { "type": "object", "additionalProperties": true }, "options": { "$ref": "#/components/schemas/CommonOptions" } }, "additionalProperties": false },
      "BatchRequest": { "type": "object", "required": ["operation","items"], "properties": { "operation": { "$ref": "#/components/schemas/GeometryOperation" }, "items": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "object", "properties": { "operation": { "$ref": "#/components/schemas/GeometryOperation" }, "input": { "$ref": "#/components/schemas/GeometryEnvelope" }, "other": { "$ref": "#/components/schemas/GeometryEnvelope" }, "parameters": { "type": "object" }, "options": { "$ref": "#/components/schemas/CommonOptions" } } } }, "continueOnError": { "type": "boolean", "default": true } }, "additionalProperties": false },
      "GeometryMetadata": { "type": "object", "required": ["type","empty","vertexCount","coordinateDimension"], "properties": { "type": { "type": "string" }, "empty": { "type": "boolean" }, "valid": { "type": "boolean" }, "vertexCount": { "type": "integer" }, "coordinateDimension": { "type": "integer" }, "srid": { "type": "integer" }, "inputType": { "type": "string" }, "typeChanged": { "type": "boolean" }, "precisionGridSize": { "type": "number" }, "units": { "enum": ["coordinate-space","coordinate-space-squared","dimensionless"] }, "bbox": { "type": "array", "items": { "type": "number" } } }, "additionalProperties": true },
      "Execution": { "type": "object", "required": ["engine","engineVersion","durationMs","operation","deterministicScope"], "properties": { "engine": { "type": "string" }, "engineVersion": { "type": "string" }, "durationMs": { "type": "number" }, "operation": { "$ref": "#/components/schemas/GeometryOperation" }, "deterministicScope": { "const": "engine-version-input-options" } }, "additionalProperties": false },
      "GeometryResult": { "type": "object", "required": ["result","summary","warnings","execution"], "properties": { "result": { "$ref": "#/components/schemas/Geometry" }, "summary": { "$ref": "#/components/schemas/GeometryMetadata" }, "warnings": { "type": "array", "items": { "type": "string" } }, "execution": { "$ref": "#/components/schemas/Execution" } }, "additionalProperties": false },
      "ScalarResult": { "type": "object", "required": ["result","summary","warnings","execution"], "properties": { "result": { "type": ["number","boolean","string"] }, "summary": { "type": "object", "additionalProperties": true }, "warnings": { "type": "array", "items": { "type": "string" } }, "execution": { "$ref": "#/components/schemas/Execution" } }, "additionalProperties": false },
      "ValidationDetail": { "type": "object", "required": ["valid","reason","location","simple","empty","closed","ring","rectangle"], "properties": { "valid": { "type": "boolean" }, "reason": { "type": ["string","null"] }, "location": { "oneOf": [{ "$ref": "#/components/schemas/Geometry" }, { "type": "null" }] }, "simple": { "type": "boolean" }, "empty": { "type": "boolean" }, "closed": { "type": ["boolean","null"] }, "ring": { "type": ["boolean","null"] }, "rectangle": { "type": ["boolean","null"] } }, "additionalProperties": false },
      "ValidationResult": { "allOf": [{ "$ref": "#/components/schemas/ScalarResult" }, { "type": "object", "required": ["detail"], "properties": { "detail": { "$ref": "#/components/schemas/ValidationDetail" } } }] },
      "BatchResult": { "type": "object", "required": ["results","summary"], "properties": { "results": { "type": "array", "items": { "type": "object", "required": ["index","status"], "properties": { "index": { "type": "integer" }, "status": { "enum": ["success","error"] }, "value": {}, "error": { "$ref": "#/components/schemas/Error" } } } }, "summary": { "type": "object", "required": ["total","succeeded","failed","inputOrderPreserved"], "properties": { "total": { "type": "integer" }, "succeeded": { "type": "integer" }, "failed": { "type": "integer" }, "inputOrderPreserved": { "const": true } } } }, "additionalProperties": false },
      "Error": { "type": "object", "required": ["code","message","recoverable"], "properties": { "code": { "enum": ["INVALID_GEOMETRY","UNSUPPORTED_GEOMETRY_TYPE","INVALID_COORDINATE","EMPTY_GEOMETRY","TOO_MANY_VERTICES","GEOMETRY_TOO_LARGE","TOO_MANY_GEOMETRIES","NESTING_TOO_DEEP","TOPOLOGY_EXCEPTION","PRECISION_ERROR","OPERATION_TIMEOUT","UNSUPPORTED_OPERATION","ENGINE_ERROR","RESOURCE_LIMIT","SRID_MISMATCH","PLANAR_ACKNOWLEDGEMENT_REQUIRED","CRS_TRANSFORMATION_UNSUPPORTED","GEODESIC_OPERATION_UNSUPPORTED","SPATIAL_DATASET_OPERATION_UNSUPPORTED","RASTER_OPERATION_UNSUPPORTED","ROUTING_OPERATION_UNSUPPORTED","H3_OPERATION_UNSUPPORTED"] }, "message": { "type": "string" }, "operation": { "$ref": "#/components/schemas/GeometryOperation" }, "geometryIndex": { "type": "integer" }, "recoverable": { "type": "boolean" }, "suggestion": { "type": "string" }, "details": { "type": "object", "additionalProperties": true } }, "additionalProperties": false },
      "ErrorResponse": { "type": "object", "required": ["error"], "properties": { "error": { "$ref": "#/components/schemas/Error" } }, "additionalProperties": false }
    }
  }
}
