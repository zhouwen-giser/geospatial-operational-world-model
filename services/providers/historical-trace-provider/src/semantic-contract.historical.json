{
  "schemaVersion": "1.0",
  "providerId": "gowm.historical-trace",
  "operations": {
    "history.get-trajectory@1.0": {
      "profile": {
        "profileVersion": "1.1",
        "domain": "ANALYSIS",
        "acceptedReferenceKinds": [
          "WORLD_OBJECT",
          "SPATIAL_OBJECT",
          "LAYER_FEATURE",
          "OPERATIONAL_TASK",
          "DERIVED_REFERENCE",
          "TASK_EXECUTION_INTERVAL",
          "HISTORY_METHOD_PROFILE"
        ],
        "producedReferenceKinds": [
          "HISTORICAL_TRAJECTORY",
          "TRACKLET_VERSION",
          "TRACKLET_FINALIZATION",
          "HISTORY_INPUT_SET"
        ],
        "relationSemantics": [
          "TEMPORALLY_OVERLAPS"
        ],
        "spatialSemantics": "EXACT",
        "timeSemantics": "HISTORICAL",
        "resultNature": "DERIVED",
        "negativeEvidencePolicy": "NO_DATA_IS_UNKNOWN",
        "freshnessSemantics": "SNAPSHOT_CURRENTNESS",
        "domainStatus": {
          "path": "/status",
          "mapping": {
            "COMPLETED": "COMPLETED",
            "PARTIAL": "PARTIAL",
            "NO_DATA": "NO_DATA",
            "INDETERMINATE": "INDETERMINATE"
          }
        },
        "notes": [
          "The operation returns one stored source-selected trajectory revision and never performs hidden multi-source fusion.",
          "Every interval, tracklet, finalization, watermark, profile, and analysis-space input is frozen by the returned snapshot or its HISTORY_INPUT_SET resource.",
          "When no as-of revision or outcome exists, the Provider only idempotently enqueues the exact frozen request and returns PROJECTION_PENDING; construction remains worker-owned.",
          "The v0.7.1 Provider returns only a bounded preview and does not advertise an artifactReference until a scope-aware artifact registry round trip is qualified."
        ]
      },
      "implementation": [
        {
          "path": "services/providers/historical-trace-provider/src/provider.ts",
          "symbol": "createHistoricalTraceProvider"
        },
        {
          "path": "services/providers/historical-trace-provider/src/repository.ts"
        }
      ],
      "exactAlgorithm": [
        {
          "path": "services/providers/historical-trace-provider/src/repository.ts",
          "symbol": "HistoricalTraceRepository"
        }
      ],
      "tests": [
        "tests/platform/historical-trace-provider.test.ts"
      ],
      "rationale": "The preview provider performs scoped, head-free reads of immutable trajectory revisions and their persisted lineage. It returns a bounded preview, gaps, completeness and trajectoryReferenceKey, but deliberately does not claim that the complete trajectory is retrievable as an Artifact. A missing result can cause only a bounded, scope-checked enqueue of the exact effective snapshot; source selection and trajectory construction remain worker projection-owned."
    },
    "history.open-trajectory-artifact@1.0": {
      "profile": {
        "profileVersion": "1.1",
        "domain": "ANALYSIS",
        "acceptedReferenceKinds": [
          "WORLD_OBJECT",
          "SPATIAL_OBJECT",
          "LAYER_FEATURE",
          "OPERATIONAL_TASK",
          "DERIVED_REFERENCE",
          "TASK_EXECUTION_INTERVAL",
          "HISTORY_METHOD_PROFILE",
          "HISTORICAL_TRAJECTORY"
        ],
        "producedReferenceKinds": [
          "HISTORICAL_TRAJECTORY",
          "HISTORY_INPUT_SET"
        ],
        "relationSemantics": [],
        "spatialSemantics": "NONE",
        "timeSemantics": "HISTORICAL",
        "resultNature": "DERIVED",
        "negativeEvidencePolicy": "NO_DATA_IS_UNKNOWN",
        "freshnessSemantics": "SNAPSHOT_CURRENTNESS",
        "domainStatus": {
          "path": "/status",
          "mapping": {
            "READY": "COMPLETED",
            "PROJECTION_PENDING": "INDETERMINATE",
            "NO_DATA": "NO_DATA",
            "INDETERMINATE": "INDETERMINATE"
          }
        },
        "notes": [
          "Artifact availability describes retrieval, not evidence completeness.",
          "The full frozen request, snapshot, evaluation, immutable revision, gap and segment metadata remain explicit.",
          "Read replay revalidates scope, byte digest and server-clock expiry."
        ]
      },
      "implementation": [
        {
          "path": "services/providers/historical-trace-provider/src/artifact-repository.ts",
          "symbol": "HistoricalArtifactRepository"
        },
        {
          "path": "services/providers/historical-trace-provider/src/artifact-operations.ts",
          "symbol": "createHistoricalArtifactOperations"
        }
      ],
      "tests": [
        "tests/platform/historical-artifact.test.ts"
      ],
      "referenceAuthorities": [
        "database/migrations/090_historical_trajectory_artifact.sql"
      ],
      "rationale": "Opens or reads bounded immutable trajectory bytes through the scoped Provider protocol. Does not create trajectory facts, fuse sources or infer completeness."
    },
    "history.read-trajectory-artifact@1.0": {
      "profile": {
