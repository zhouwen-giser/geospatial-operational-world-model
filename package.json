{
  "name": "geospatial-operational-world-model",
  "version": "0.1.0",
  "private": true,
  "description": "GOWM+ unified geospatial data foundation with independently deployable STAS analysis service",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/platform/*",
    "packages/integrations/*",
    "services/gateway/*",
    "services/providers/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix services/stas run build",
    "check": "tsc -p tsconfig.json --noEmit && npm --prefix services/stas run typecheck",
    "verify:sql": "node scripts/verify-sql.mjs",
    "verify": "npm run check && npm run verify:sql && npm test && npm --prefix services/stas test && npm run build",
    "verify:v1.2": "npm run verify",
    "validate:stas": "node validation/scripts/stas-all-tools-e2e.mjs",
    "validate:ingest-stas": "tsx validation/scripts/ingest-to-stas-e2e.ts",
    "validate:evidence": "node validation/scripts/collect-runtime-evidence.mjs",
    "validate:boundaries": "node validation/architecture/validate-capability-boundaries.mjs",
    "dev:api": "tsx services/world-api/src/index.ts",
    "dev:ingest": "tsx services/observation-ingest/src/index.ts",
    "dev:worker": "tsx services/projection-worker/src/index.ts",
    "dev:mcp": "tsx services/world-mcp-server/src/index.ts",
    "dev:stas": "npm --prefix services/stas run dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:assert": "tsx scripts/run-db-assertions.ts",
    "simulate": "tsx simulator/src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scenario": "vitest run tests/scenario",
    "test:integration": "vitest run tests/integration",
    "test:platform": "vitest run tests/platform",
    "test:stas": "npm --prefix services/stas test",
    "benchmark": "npm run build && node dist/tests/performance/benchmark.js",
    "benchmark:postgis": "npm run build && node dist/tests/performance/postgis-benchmark.js",
    "benchmark:mqtt": "npm run build && node dist/tests/performance/mqtt-benchmark.js",
    "benchmark:http": "npm run build && node dist/tests/performance/http-load.js",
    "replay": "npm run build && node dist/scripts/replay.js",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.11.3",
    "h3-js": "4.5.0",
    "mqtt": "5.15.2",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "pgsql-parser": "18.2.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
