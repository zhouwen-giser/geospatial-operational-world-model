{
  "name": "geospatial-operational-world-model",
  "version": "0.6.0",
  "private": true,
  "description": "GOWM+ unified geospatial data foundation with independently deployable STAS analysis service",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/platform/*",
    "packages/integrations/*",
    "services/gateway/*",
    "services/providers/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm --prefix services/stas run build",
    "check": "npm run verify:contracts && tsc -p tsconfig.json --noEmit && npm --prefix services/stas run typecheck",
    "generate:contracts": "node packages/platform/contract-runtime/scripts/generate-contract-types.mjs",
    "verify:contracts": "node packages/platform/contract-runtime/scripts/generate-contract-types.mjs --check",
    "verify:sql": "node scripts/verify-sql.mjs",
    "verify": "npm run check && npm run verify:sql && npm test && npm --prefix services/stas test && npm run build",
    "verify:v1.2": "npm run verify",
    "validate:stas": "node validation/scripts/stas-all-tools-e2e.mjs",
    "validate:ingest-stas": "tsx validation/scripts/ingest-to-stas-e2e.ts",
    "validate:evidence": "node validation/scripts/collect-runtime-evidence.mjs",
    "validate:grounding-security": "node validation/scripts/grounding-security-adversarial.mjs",
    "validate:grounding-ready": "node validation/scripts/grounding-gateway-restart-e2e.mjs",
    "validate:operational-events": "node --import tsx validation/scripts/operational-event-store-e2e.ts",
    "validate:operational-provider": "node --import tsx validation/scripts/operational-provider-gateway-e2e.ts",
    "validate:operational-ready": "node --import tsx validation/scripts/operational-reality-ready-e2e.ts",
    "validate:network-db-runtime": "node validation/scripts/network-db-runtime-gate.mjs",
    "validate:network-schema-runtime": "node validation/scripts/network-schema-runtime-gate.mjs",
    "validate:network-topology-runtime": "npm run build && node --import tsx validation/scripts/network-topology-runtime-gate.ts",
    "validate:network-turn-runtime": "npm run build && node --import tsx validation/scripts/network-turn-runtime-gate.ts",
    "validate:network-profile-runtime": "npm run build && node --import tsx validation/scripts/network-profile-runtime-gate.ts",
    "validate:network-activation-runtime": "npm run build && node --import tsx validation/scripts/network-activation-runtime-gate.ts",
    "validate:network-provider-runtime": "npm run build && node --import tsx validation/scripts/network-provider-runtime-gate.ts",
    "validate:route-planning-runtime": "npm run build && node --import tsx validation/scripts/route-planning-runtime-gate.ts",
    "validate:route-verifier-runtime": "npm run build && node --import tsx validation/scripts/route-verifier-runtime-gate.ts",
    "validate:network-routing-gateway": "npm run build && node --import tsx validation/scripts/network-routing-gateway-e2e.ts",
    "validate:gowm-v05-migrations": "npm run build && node --import tsx validation/scripts/gowm-v05-migration-e2e.ts",
    "validate:gowm-v05-performance": "npm run build && node --import tsx validation/scripts/gowm-v05-routing-performance.ts",
    "validate:gowm-v05-final": "node validation/scripts/gowm-v05-final-candidate.mjs",
    "validate:gowm-v06-predecessor": "node validation/scripts/gowm-v06-predecessor-guard.mjs",
    "validate:gowm-v06-source-policy": "node validation/scripts/gowm-v06-source-policy-guard.mjs",
    "validate:gowm-v06-boundaries": "node validation/architecture/validate-road-coverage-boundaries.mjs",
    "validate:gowm-v06-database": "node validation/scripts/coverage-schema-runtime-gate.mjs",
    "validate:gowm-v06-gateway": "npm run build && node validation/scripts/coverage-gateway-runtime-gate.mjs",
    "validate:gowm-v06-security-recovery": "npm run build && node validation/scripts/coverage-security-performance-recovery-gate.mjs",
    "validate:gowm-v06-compatibility": "npm run build && node validation/scripts/coverage-compatibility-runtime-gate.mjs",
    "validate:gowm-v06-final-docs": "node validation/scripts/gowm-v06-final-docs-guard.mjs",
    "validate:gowm-v06-final-candidate": "node validation/scripts/gowm-v06-final-candidate-gate.mjs",
    "validate:provider-conformance": "node validation/scripts/provider-conformance-gate.mjs",
    "validate:gowm-v06-selection": "npm run build && node validation/scripts/coverage-selection-runtime-gate.mjs",
    "validate:gowm-v06-canonical-problem": "npm run build && node validation/scripts/coverage-canonical-problem-gate.mjs",
    "validate:gowm-v06-endpoints": "npm run build && node validation/scripts/coverage-endpoint-runtime-gate.mjs",
    "validate:gowm-v06-closed-dcpp": "npm run build && node validation/scripts/coverage-closed-dcpp-gate.mjs",
    "validate:gowm-v06-open-dcpp": "npm run build && node validation/scripts/coverage-open-dcpp-gate.mjs",
    "validate:gowm-v06-fixed-rpp": "npm run build && node validation/scripts/coverage-fixed-rpp-gate.mjs",
    "validate:gowm-v06-strict-routing": "npm run build && node validation/scripts/coverage-strict-routing-gate.mjs",
    "validate:gowm-v06-verifier": "npm run build && node validation/scripts/coverage-independent-verifier-gate.mjs",
    "validate:gowm-v06-alternatives": "npm run build && node validation/scripts/coverage-alternatives-gate.mjs",
    "validate:gowm-v06-async": "npm run build && node validation/scripts/coverage-async-runtime-gate.mjs",
    "validate:gowm-v06-provider": "npm run build && node validation/scripts/coverage-provider-protocol-gate.mjs",
    "sbom:service": "node scripts/generate-service-sbom.mjs",
    "validate:stable-contracts": "node validation/scripts/stable-contract-compatibility.mjs",
    "validate:stable-migrations": "node --import tsx validation/scripts/stable-migration-replay-e2e.ts",
    "validate:stable-runtime": "node validation/scripts/stable-security-load-recovery.mjs",
    "validate:stable-version": "node validation/scripts/stable-version-guard.mjs",
    "validate:stable-final": "node validation/scripts/stable-final-candidate.mjs",
    "validate:boundaries": "node validation/architecture/validate-capability-boundaries.mjs",
    "dev:api": "tsx services/world-api/src/index.ts",
    "dev:ingest": "tsx services/observation-ingest/src/index.ts",
    "dev:worker": "tsx services/projection-worker/src/index.ts",
    "dev:mcp": "tsx services/world-mcp-server/src/index.ts",
    "dev:stas": "npm --prefix services/stas run dev",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:assert": "tsx scripts/run-db-assertions.ts",
    "simulate": "tsx simulator/src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scenario": "vitest run tests/scenario",
    "test:integration": "vitest run tests/integration",
    "test:platform": "vitest run tests/platform",
    "test:stas": "npm --prefix services/stas test",
    "benchmark": "npm run build && node dist/tests/performance/benchmark.js",
    "benchmark:postgis": "npm run build && node dist/tests/performance/postgis-benchmark.js",
    "benchmark:mqtt": "npm run build && node dist/tests/performance/mqtt-benchmark.js",
    "benchmark:http": "npm run build && node dist/tests/performance/http-load.js",
    "replay": "npm run build && node dist/scripts/replay.js",
    "acceptance": "bash scripts/acceptance.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "fastify": "5.11.3",
    "h3-js": "4.5.0",
    "mqtt": "5.15.2",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "pgsql-parser": "18.2.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
