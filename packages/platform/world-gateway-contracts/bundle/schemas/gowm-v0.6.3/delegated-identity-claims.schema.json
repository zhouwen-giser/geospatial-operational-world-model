{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.6.3:delegation-token-claims",
  "title": "DelegationTokenClaims",
  "type": "object",
  "additionalProperties": false,
  "required": ["iss", "sub", "aud", "iat", "nbf", "exp", "jti", "act", "requestId", "delegationDepth", "dataScopes", "datasetScopes", "allowedOperations"],
  "properties": {
    "iss": { "type": "string", "minLength": 1, "maxLength": 512 },
    "sub": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aud": { "type": "string", "minLength": 1, "maxLength": 256 },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "jti": { "type": "string", "minLength": 16, "maxLength": 256 },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sub"],
      "properties": {
        "sub": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "type": "string", "maxLength": 64 }
      }
    },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "delegationDepth": { "const": 1 },
    "dataScopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "datasetScopes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[0-9]+\\.[0-9]+$" }
    }
  }
}
