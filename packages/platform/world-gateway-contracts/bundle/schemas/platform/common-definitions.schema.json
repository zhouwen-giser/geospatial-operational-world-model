{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:common-definitions",
  "title": "PlatformCommonDefinitions",
  "$defs": {
    "operationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "operationVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,255}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "schemaUri": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "operationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "operationVersion",
        "inputSchemaHash",
        "outputSchemaHash"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/operationId" },
        "operationVersion": { "$ref": "#/$defs/operationVersion" },
        "inputSchemaHash": { "$ref": "#/$defs/sha256Digest" },
        "outputSchemaHash": { "$ref": "#/$defs/sha256Digest" }
      }
    },
    "referenceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version"],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
