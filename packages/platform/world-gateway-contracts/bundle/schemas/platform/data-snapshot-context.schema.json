{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.2:data-snapshot-context",
  "title": "DataSnapshotContext",
  "description": "Absent for world-independent work. Presence always identifies at least one versioned data resource.",
  "type": "object",
  "additionalProperties": false,
  "required": ["consistency", "capturedAt", "scopeDigest", "resources"],
  "properties": {
    "consistency": {
      "enum": ["PINNED", "CONSISTENT_AT_START", "BEST_EFFORT"]
    },
    "capturedAt": { "type": "string", "format": "date-time" },
    "scopeDigest": { "$ref": "common-definitions.schema.json#/$defs/sha256Digest" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceKey", "authority", "pinning"],
        "properties": {
          "referenceKey": {
            "$ref": "common-definitions.schema.json#/$defs/referenceKey"
          },
          "authority": { "type": "string", "minLength": 1, "maxLength": 128 },
          "pinning": { "enum": ["PINNED", "AT_LEAST", "BEST_EFFORT"] },
          "digest": { "$ref": "common-definitions.schema.json#/$defs/sha256Digest" },
          "worldVersion": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
