{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7:analysis-resource-reference",
  "title": "GowmV07AnalysisResourceReference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inputRole", "resourceReferenceKey", "pinning", "authority"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "inputRole": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "resourceReferenceKey": { "$ref": "../platform/common-definitions.schema.json#/$defs/referenceKey" },
    "contentHash": { "$ref": "../platform/common-definitions.schema.json#/$defs/sha256Digest" },
    "worldVersion": { "type": "integer", "minimum": 0 },
    "pinning": { "enum": ["PINNED", "AT_LEAST", "BEST_EFFORT"] },
    "authority": { "type": "string", "minLength": 1, "maxLength": 128 },
    "worldReferenceKey": { "$ref": "../platform/common-definitions.schema.json#/$defs/referenceKey" },
    "sourceAnalysisReferenceKey": { "$ref": "../platform/common-definitions.schema.json#/$defs/referenceKey" }
  }
}
