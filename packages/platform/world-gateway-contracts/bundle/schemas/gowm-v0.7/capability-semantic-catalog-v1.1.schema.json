{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7:capability-semantic-catalog",
  "title": "CapabilitySemanticCatalogV1_1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractCatalogRevision",
    "bindingRevision",
    "profiles",
    "catalogHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "registryRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "contractCatalogRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bindingRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "operationVersion",
          "semanticProfile",
          "semanticProfileHash"
        ],
        "properties": {
          "operationId": {
            "type": "string"
          },
          "operationVersion": {
            "type": "string"
          },
          "semanticProfile": {
            "$ref": "capability-semantic-profile-v1.1.schema.json"
          },
          "semanticProfileHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "catalogHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
