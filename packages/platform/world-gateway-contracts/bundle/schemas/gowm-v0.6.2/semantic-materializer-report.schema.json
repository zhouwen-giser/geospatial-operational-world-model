{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.6.2:semantic-materializer-report",
  "title": "SemanticMaterializerReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resolved",
    "conflicts",
    "insufficient",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "resolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "insufficient": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "determinismHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  }
}
