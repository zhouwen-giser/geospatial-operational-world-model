{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gowm:v0.7.1:wsgs-historical-consumer-lock",
  "title": "GowmV071WsgsHistoricalConsumerLock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidateCommit",
    "candidateTree",
    "ciSource",
    "bindingRevision",
    "consumerContractPackage",
    "providerManifests",
    "operations",
    "snapshotBehavior",
    "migrationHead",
    "runtimeQualificationEvidenceDigest",
    "allowedConsumerCapabilities",
    "explicitNonClaims",
    "marker"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "candidateCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateTree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ciSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["githubRepository", "githubWorkflowRef", "githubRunId", "githubRunAttempt"],
      "properties": {
        "githubRepository": { "const": "zhouwen-giser/geospatial-operational-world-model" },
        "githubWorkflowRef": { "const": "zhouwen-giser/geospatial-operational-world-model/.github/workflows/gowm-v071-exact-head-qualification.yml@refs/heads/main" },
        "githubRunId": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" },
        "githubRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]{0,31}$" }
      }
    },
    "bindingRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "consumerContractPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "contractCatalogRevision", "semanticCatalogHash"],
      "properties": {
        "name": { "const": "@gowm/world-gateway-contracts" },
        "version": { "const": "0.7.1" },
        "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" },
        "contractCatalogRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "semanticCatalogHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "providerManifests": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": { "type": "object", "required": ["providerId"], "properties": { "providerId": { "const": "gowm.operational-reality" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "type": "object", "required": ["providerId"], "properties": { "providerId": { "const": "gowm.historical-trace" } } },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "providerVersion", "implementationDigest", "manifestHash"],
        "properties": {
          "providerId": { "enum": ["gowm.operational-reality", "gowm.historical-trace"] },
          "providerVersion": { "type": "string" },
          "implementationDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "manifestHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["operationId", "providerId"],
            "properties": {
              "operationId": { "const": "operational-task.get-execution-intervals" },
              "providerId": { "const": "gowm.operational-reality" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["operationId", "providerId"],
            "properties": {
              "operationId": { "const": "history.get-trajectory" },
              "providerId": { "const": "gowm.historical-trace" }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "providerId", "operationVersion", "inputSchemaHash", "outputSchemaHash", "semanticProfileHash", "maturity"],
        "properties": {
          "operationId": { "enum": ["operational-task.get-execution-intervals", "history.get-trajectory"] },
          "providerId": { "enum": ["gowm.operational-reality", "gowm.historical-trace"] },
          "operationVersion": { "type": "string" },
          "inputSchemaHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "outputSchemaHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "semanticProfileHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "maturity": { "const": "PREVIEW" }
        }
      }
    },
    "snapshotBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeModel", "resourceIdEncodingRevision", "canonicalOrderingRevision", "authorizedDowngradeResourceRetentionRevision", "historicalEventSetSeparationRevision"],
      "properties": {
        "scopeModel": { "const": "SINGLE_SCOPE_V1" },
        "resourceIdEncodingRevision": { "const": "SNAPSHOT_RESOURCE_ID_V1_512" },
        "canonicalOrderingRevision": { "const": "UNICODE_CODE_POINT_BINARY_V1" },
        "authorizedDowngradeResourceRetentionRevision": { "const": "ACTUAL_PROVIDER_RESOURCES_RETAINED_WITHOUT_PINNING_STRENGTHENING_V1" },
        "historicalEventSetSeparationRevision": { "const": "CURRENT_AND_INTERVAL_INPUT_EVENT_SETS_DISTINCT_V1" }
      }
    },
    "migrationHead": { "const": "069_task_execution_event_set_read_contract.sql" },
    "runtimeQualificationEvidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "allowedConsumerCapabilities": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["TASK_EXECUTION_INTERVAL", "HISTORICAL_TRAJECTORY", "GAP", "COMPLETENESS", "CURRENTNESS_REPLAY_FOUNDATION"] }
    },
    "explicitNonClaims": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["MAP_MATCHING", "TEMPORAL_SPATIAL_EVENTS", "LAST_INTERSECTION", "HISTORICAL_SIGNAL_RANKING", "COMPLETE_TRAJECTORY_ARTIFACT"] }
    },
    "marker": { "const": "GOWM_V071_WSGS_HISTORICAL_BASELINE_READY" }
  }
}
